#!/usr/bin/env python3
"""openwrath — developer modding CLI for the OpenWrath / Kane's Wrath toolchain.

A thin, config-driven orchestration layer over the OpenWrath compiler/decompiler and the
stream-surgery tools, so modding doesn't require tribal knowledge of where everything lives.

Design rules (hard):
  * NO path to any specific machine is baked into this code. Everything a user's setup
    needs is discovered at runtime (`detect`) or read from a per-user config. The only
    literals here are facts about the GAME (Steam appid, install folder name) — never a
    personal path.
  * Ships ZERO game data. It operates on the user's own install / SDK, which they own.
  * Config lives at $XDG_CONFIG_HOME/openwrath/config.toml (per-user, outside any repo),
    so there is nothing to gitignore and no path ever lands in version control.

Subcommands:
  detect        auto-discover this machine's KW install / prefix / mods / SDK and write the config
  show          print the resolved config and flag anything missing
  mod bake      compile a mod's overrides + splice/insert them into a target stream, repack, install
  mod revert    restore a target mod's big from the last openwrath backup
  inspect <a>   decompile + print ONE asset from the installed stream (what the game actually loads)
  find <text>   list installed assets whose name contains <text> (optionally --type)
  uses <a>      list assets that REFERENCE <a> (reverse refs — spot shared templates before editing)
  trace <a>     print <a>'s outgoing reference tree (unit -> weapons -> projectiles -> fx -> ...)
"""
import argparse
import os
import re
import sys
from pathlib import Path

# --- verbosity ---------------------------------------------------------------------------
# Diagnostics (resolved paths, cache hit/miss, timings, counts) go to STDERR and only when
# --verbose is set, so default stdout stays clean and pipeable.
_VERBOSE = False


def vlog(msg: str) -> None:
    if _VERBOSE:
        print(msg, file=sys.stderr)

# --- Game facts (NOT user paths; constants about Kane's Wrath itself) --------------------
APPID = "24810"
GAME_DIR_NAME = "Command and Conquer 3 - Kane's Wrath"   # steamapps/common/<this>
WINE_DOCS_NAME = "Command & Conquer 3 Kane's Wrath"       # drive_c/.../Documents/<this>
SKUDEF_GLOB = "CNC3EP1_english_*.SkuDef"                  # the launcher picks the highest version

CONFIG_PATH = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    / "openwrath" / "config.toml"
)

# Keys we resolve, with a human description. Discovered keys are auto-filled by `detect`;
# "byo" (bring-your-own) keys are things only the user can point us at (their SDK, etc.).
SCHEMA = [
    ("steam_root",     "auto", "Steam root (Flatpak / native)"),
    ("game_install",   "auto", "KW install dir (holds CNC3EP1.exe + the master SkuDef)"),
    ("prefix",         "auto", "Proton/Wine prefix for KW"),
    ("mods_dir",       "auto", "Where mods are installed (Wine Documents/.../Mods)"),
    ("install_skudef", "auto", "Active master SkuDef the launcher reads"),
    ("openwrath",      "auto", "OpenWrath toolchain dir (this repo; holds Debug/)"),
    ("sdk",            "byo",  "Kane's Wrath XML SDK (KanesWrathXMLFiles) — you provide"),
    ("base_manifests", "byo",  "SDK 'Game Files/Manifest' dir (global/static manifests)"),
    ("schema",         "byo",  "CnC3Types.xsd schema"),
    ("stringhashes",   "byo",  "master StringHashes.xml (EA-derived; you generate/provide)"),
]


# --- tiny TOML writer (flat [paths] table of strings; avoids a write-dep) ----------------
def write_config(cfg: dict) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "# openwrath config — per-user, auto-written by `openwrath detect`.",
        "# Edit freely; re-run `openwrath detect` to re-discover the 'auto' paths.",
        "",
        "[paths]",
    ]
    for key, _, desc in SCHEMA:
        val = cfg.get(key, "") or ""
        lines.append(f'{key} = "{val}"' + (f"   # {desc}" if not val else ""))
    CONFIG_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")


def read_config() -> dict:
    if not CONFIG_PATH.exists():
        return {}
    import tomllib
    with open(CONFIG_PATH, "rb") as f:
        return tomllib.load(f).get("paths", {})


# --- Steam / prefix discovery ------------------------------------------------------------
def steam_roots() -> list[Path]:
    home = Path.home()
    candidates = [
        home / ".var/app/com.valvesoftware.Steam/.local/share/Steam",  # Flatpak
        home / ".local/share/Steam",                                   # native
        home / ".steam/steam",
        home / ".steam/root",
    ]
    seen, out = set(), []
    for c in candidates:
        rp = c.resolve() if c.exists() else c
        if c.exists() and rp not in seen:
            seen.add(rp)
            out.append(c)
    return out


def library_paths(steam_root: Path) -> list[Path]:
    """Every Steam library folder (games may live on other drives), from libraryfolders.vdf."""
    libs = [steam_root]
    for vdf in (steam_root / "steamapps/libraryfolders.vdf",
                steam_root / "config/libraryfolders.vdf"):
        if vdf.exists():
            for m in re.finditer(r'"path"\s*"([^"]+)"', vdf.read_text(errors="replace")):
                p = Path(m.group(1))
                if p not in libs:
                    libs.append(p)
    return libs


def find_install_and_prefix() -> tuple[Path | None, Path | None, Path | None]:
    """Return (steam_root, game_install, prefix) for appid 24810, or Nones."""
    for root in steam_roots():
        for lib in library_paths(root):
            install = lib / "steamapps/common" / GAME_DIR_NAME
            prefix = lib / "steamapps/compatdata" / APPID / "pfx"
            if install.exists():
                return root, install, (prefix if prefix.exists() else None)
    return None, None, None


def find_mods_dir(prefix: Path) -> Path | None:
    docs = prefix / "drive_c/users/steamuser/Documents" / WINE_DOCS_NAME / "Mods"
    return docs if docs.exists() else None


def find_install_skudef(install: Path) -> Path | None:
    """The launcher reads the highest-version english SkuDef; pick that one."""
    skus = sorted(install.glob(SKUDEF_GLOB))
    def ver(p: Path):
        m = re.search(r"_(\d+)\.(\d+)\.SkuDef$", p.name)
        return (int(m.group(1)), int(m.group(2))) if m else (0, 0)
    return max(skus, key=ver) if skus else None


def openwrath_dir() -> Path:
    """This repo (the CLI lives in <repo>/modkit/openwrath)."""
    return Path(__file__).resolve().parent.parent


def probe_byo(repo: Path) -> dict:
    """Best-effort guesses for bring-your-own paths — only used to pre-fill; never required."""
    home = Path.home()
    out = {}
    for sdk in (home / "cnc-kw-sdk/KanesWrathXMLFiles",):
        if sdk.exists():
            out["sdk"] = str(sdk)
            mani = sdk.parent / "Game Files/Manifest"
            if mani.exists():
                out["base_manifests"] = str(mani)
            break
    sch = repo / "schemas/kw/xsd/CnC3Types.xsd"
    if sch.exists():
        out["schema"] = str(sch)
    return out


# --- commands ----------------------------------------------------------------------------
def cmd_detect(_args) -> int:
    print("openwrath detect — discovering your Kane's Wrath setup...\n")
    cfg = read_config()  # keep any values the user already set
    root, install, prefix = find_install_and_prefix()
    repo = openwrath_dir()

    found = dict(cfg)
    if root:    found["steam_root"] = str(root)
    if install: found["game_install"] = str(install)
    if prefix:  found["prefix"] = str(prefix)
    if prefix and (mods := find_mods_dir(prefix)): found["mods_dir"] = str(mods)
    if install and (sku := find_install_skudef(install)): found["install_skudef"] = str(sku)
    found["openwrath"] = str(repo)
    for k, v in probe_byo(repo).items():
        found.setdefault(k, v)

    write_config(found)

    missing = [k for k, kind, _ in SCHEMA if not found.get(k)]
    for key, kind, desc in SCHEMA:
        val = found.get(key, "")
        mark = "ok " if val else ("-- " if kind == "byo" else "!! ")
        print(f"  [{mark}] {key:15} {val or '(not found — ' + desc + ')'}")
    print(f"\nconfig written -> {CONFIG_PATH}")
    if missing:
        byo = [k for k in missing if dict((s[0], s[1]) for s in SCHEMA)[k] == "byo"]
        auto = [k for k in missing if k not in byo]
        if auto:
            print(f"\n  ⚠ could not auto-detect: {', '.join(auto)} — set them in the config above.")
        if byo:
            print(f"  → bring-your-own (point these at your own files): {', '.join(byo)}")
    return 0


def cmd_show(_args) -> int:
    cfg = read_config()
    if not cfg:
        print(f"no config at {CONFIG_PATH} — run `openwrath detect` first.")
        return 1
    print(f"config: {CONFIG_PATH}\n")
    for key, kind, desc in SCHEMA:
        val = cfg.get(key, "")
        exists = " " if not val else ("ok" if Path(val).exists() else "MISSING-ON-DISK")
        print(f"  {key:15} [{exists:>15}]  {val}")
    return 0


# --- mod bake: compile overrides -> splice into a target stream -> repack -> install -------
LIB = Path(__file__).resolve().parent / "lib"
MANIFEST_V5_HDR = 48
MANIFEST_ENTRY = 44


def _need(cfg: dict, *keys) -> list[str]:
    import tomllib  # noqa: F401  (ensures 3.11+)
    vals = []
    for k in keys:
        v = cfg.get(k)
        if not v or not Path(v).exists():
            sys.exit(f"error: config '{k}' is unset or missing on disk — run `openwrath detect` "
                     f"(or set it in {CONFIG_PATH}).")
        vals.append(v)
    return vals


def parse_manifest(path: str) -> list[dict]:
    """Parse a v5 linked-stream manifest into per-asset dicts (incl. qualified name)."""
    import struct
    b = Path(path).read_bytes()
    h = struct.unpack_from("<11I", b, 4)
    n, arsz, rmsz, ansz = h[2], h[7], h[8], h[9]
    name_base = MANIFEST_V5_HDR + n * MANIFEST_ENTRY + arsz + rmsz
    out = []
    for i in range(n):
        o = MANIFEST_V5_HDR + i * MANIFEST_ENTRY
        tid, iid, th, ih = struct.unpack_from("<4I", b, o)
        noff = struct.unpack_from("<i", b, o + 24)[0]
        name = None
        if noff >= 0:
            p = name_base + noff
            name = b[p:b.index(b"\x00", p)].decode("latin1", "replace")
        out.append({"tid": tid, "iid": iid, "th": th, "ih": ih, "name": name})
    return out


def declared_overrides(source_xml: Path) -> list[str]:
    """Instance ids the mod itself declares as top-level overrides (not inside <Includes>)."""
    import xml.etree.ElementTree as ET
    root = ET.parse(source_xml).getroot()
    skip = {"Tags", "Includes"}
    ids = []
    for child in root:
        tag = child.tag.split("}")[-1]
        if tag in skip:
            continue
        cid = child.get("id")
        if cid:
            ids.append(cid)
    return ids


def game_running() -> bool:
    """True if the Kane's Wrath EXECUTABLE is running — swapping its big out from under it freezes it.

    Matches the game exe (cnc3ep1.dat/.exe) specifically, not mere path mentions (Steam wrappers,
    our own tooling, or a shell command that happens to name the game) — those are filtered out.
    """
    import subprocess
    r = subprocess.run(["pgrep", "-afi", r"cnc3ep1\.(dat|exe)"], capture_output=True, text=True)
    if r.returncode != 0:
        return False
    ours = ("openwrath", "modkit", "pgrep", "bab-decompile", "BinaryAssetBuilder",
            "splice_asset.py", "big_replace.py", "bigextract.py")
    return any(ln.strip() and not any(o in ln for o in ours) for ln in r.stdout.splitlines())


def _dotnet_env() -> dict:
    """Environment for invoking the .NET toolchain (BAB / bab-decompile / roundtrip.sh).

    Ensures the per-user profile bin (where `dotnet` lives) is on PATH and the roll-forward
    knobs are set, without baking a personal path: the per-user profile dir is a NixOS fact,
    added only if present so this stays a no-op elsewhere."""
    env = dict(os.environ, DOTNET_ROLL_FORWARD="LatestMajor",
               DOTNET_ROLL_FORWARD_TO_PRERELEASE="1",
               DOTNET_CLI_TELEMETRY_OPTOUT="1", DOTNET_NOLOGO="1")
    peruser = f"/etc/profiles/per-user/{os.environ.get('USER', '')}/bin"
    if os.path.isdir(peruser) and peruser not in env.get("PATH", "").split(os.pathsep):
        env["PATH"] = peruser + os.pathsep + env.get("PATH", "")
    return env


def _run(cmd: list[str], **kw):
    import subprocess
    return subprocess.run(cmd, env=_dotnet_env(), **kw)


# --- session cache for extracted streams -------------------------------------------------
# Extracting a full stream (manifest + the big .bin/.relo/.imp) from a BIG is slow, so cache
# the extracted files per (big, stream) under $XDG_CACHE_HOME/openwrath, keyed on the big's
# mtime+size. If the big changes (mtime or size differs) the signature changes and we extract
# afresh — correctness first. inspect/verify use this; find/uses/trace keep their fast
# manifest-only extraction.
def _cache_root() -> Path:
    base = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    return base / "openwrath"


def _big_sig(big: Path) -> str:
    st = big.stat()
    return f"{st.st_mtime_ns}-{st.st_size}"


_STREAM_EXTS = ("manifest", "bin", "relo", "imp")


def ensure_stream_cache(big: Path, stream: str, label: str,
                        no_cache: bool = False) -> tuple[Path, bool]:
    """Return (dir containing <stream>.{manifest,bin,relo,imp}, cache_hit).

    With no_cache, extract to a throwaway temp dir (caller may leave it; it lands in the OS
    temp). Otherwise populate a stable per-(big,stream,signature) cache dir and reuse it when a
    completion marker proves a prior extraction finished for this exact big."""
    import tempfile, time
    if no_cache:
        d = Path(tempfile.mkdtemp(prefix="openwrath-nocache-"))
        t0 = time.time()
        _extract(big, f"{stream}.", d)
        vlog(f"  extract (no-cache) {stream} from {big} -> {d}  ({time.time()-t0:.2f}s)")
        return d, False

    sig = _big_sig(big)
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", label) or "target"
    d = _cache_root() / f"{safe}-{stream}-{sig}"
    marker = d / ".complete"
    man = d / f"{stream}.manifest"
    if marker.exists() and man.exists() and man.stat().st_size > 0:
        vlog(f"  stream cache HIT: {d}")
        return d, True

    vlog(f"  stream cache MISS: {d}")
    d.mkdir(parents=True, exist_ok=True)
    t0 = time.time()
    _extract(big, f"{stream}.", d)
    if not man.exists() or man.stat().st_size == 0:
        sys.exit(f"error: could not extract stream '{stream}' from {big.name} "
                 f"(no {stream}.manifest produced).")
    marker.write_text(sig, encoding="utf-8")
    vlog(f"  extracted {stream} from {big} -> {d}  ({time.time()-t0:.2f}s)")
    return d, False


def compile_source(cfg: dict, source: Path, outdir: Path) -> tuple[Path, Path]:
    """Compile one override XML; return (stream_manifest, assets_dir)."""
    import glob
    bab = Path(cfg["openwrath"]) / "Debug/BinaryAssetBuilder.dll"
    bm = Path(cfg["base_manifests"])
    rm = f'{bm/"global_common_2.manifest"};{bm/"static_common_2.manifest"}'
    outdir.mkdir(parents=True, exist_ok=True)
    r = _run(["dotnet", str(bab), str(source), f'-dr:{cfg["sdk"]}', f'-data:{cfg["sdk"]}',
              f"-od:{outdir}", f'-sp:{cfg["schema"]}', f'-bps:{bm/"static_common_2.manifest"}',
              f"-rm:{rm}", "-ls:true", "-cpf:_mod", "-sc:false", "-bc:false"],
             capture_output=True, text=True)
    manifests = glob.glob(str(outdir / "*_mod.manifest"))
    if not manifests:
        sys.exit(f"error: compile produced no stream for {source.name}:\n{r.stdout[-800:]}")
    mf = Path(manifests[0])
    return mf, mf.with_suffix("") / "assets"


def big_is_complete(path) -> bool:
    """A BIG4 archive is complete iff no file-table entry's data extends past the physical file.
    Cheap structural check (reads only the header/table) that catches a truncated or short-written big
    before it is installed or trusted."""
    import struct
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            if f.read(4) != b"BIG4":
                return False
            f.seek(8)
            count, _firstoff = struct.unpack(">II", f.read(8))
            max_end = 0
            for _ in range(count):
                off, sz = struct.unpack(">II", f.read(8))
                name = b""
                while not name.endswith(b"\x00"):
                    ch = f.read(1)
                    if not ch:
                        return False
                    name += ch
                max_end = max(max_end, off + sz)
        return max_end <= size
    except Exception:
        return False


def find_target_big_and_stream(cfg: dict, target: str, override_iids: set[int],
                               stream_opt: str | None) -> tuple[Path, str, set[int]]:
    """Resolve the .big to patch, which linked stream to use, and that stream's existing instance ids.

    Returns (big, stream, stream_iids). The caller splits override ids by membership in stream_iids:
    ids already present are REPLACED (splice), ids not present are ADDED (insert) — so a mod can ship
    brand-new assets, not only tweak existing ones.

    If mod.toml pins `stream`, use it (new ids are fine — they get inserted). Otherwise pick the stream
    that already holds the most of the override ids; if some ids are new, the stream must be pinned so we
    know where to add them.
    """
    import subprocess, tempfile
    if target.lower() == "base":
        sys.exit("error: target='base' not supported yet — target an installed mod for now.")
    big = Path(cfg["mods_dir"]) / target / "ada_1_Streams.big"
    if not big.exists():
        sys.exit(f"error: target mod big not found: {big}")

    def iids_of(st: str) -> set[int]:
        with tempfile.TemporaryDirectory() as td:
            subprocess.run(["python3", str(LIB / "bigextract.py"), str(big), f"{st}.manifest", td],
                           capture_output=True)
            mp = Path(td) / f"{st}.manifest"
            return {e["iid"] for e in parse_manifest(str(mp))} if mp.exists() else set()

    if stream_opt:
        got = iids_of(stream_opt)
        if not got:
            sys.exit(f"error: stream '{stream_opt}' not found in {big.name}.")
        return big, stream_opt, got

    listing = subprocess.run(["python3", str(LIB / "biglist.py"), str(big), "manifest"],
                             capture_output=True, text=True).stdout
    streams = sorted({re.search(r"data.(\w+)\.manifest", ln).group(1)
                      for ln in listing.splitlines() if ".manifest" in ln and "cdata" not in ln})
    best = None  # (overlap_count, stream, iids)
    for st in streams:
        got = iids_of(st)
        if override_iids <= got:
            return big, st, got                 # contains ALL ids -> definitive
        overlap = len(override_iids & got)
        if overlap and (best is None or overlap > best[0]):
            best = (overlap, st, got)
    if best:
        _, st, got = best
        if not override_iids <= got:
            sys.exit(f"error: some override ids are NEW (not in any single stream). Pin the target stream in\n"
                     f"       mod.toml ([mod] stream = \"{st}\") so openwrath knows where to insert them.")
        return big, st, got
    sys.exit(f"error: none of {big.name}'s streams contain the override ids — is the target right?")


def cmd_mod_bake(args) -> int:
    import tomllib, tempfile, shutil, glob, subprocess
    proj = Path(args.project).resolve()
    toml = proj / "mod.toml"
    if not toml.exists():
        sys.exit(f"error: no mod.toml in {proj}")
    spec = tomllib.loads(toml.read_text()).get("mod", {})
    name = spec.get("name", proj.name)
    target = spec.get("target") or sys.exit("error: mod.toml needs [mod] target = \"<ModName>\"")
    sources = [proj / s for s in spec.get("sources", [])] or sys.exit("error: mod.toml needs sources")

    cfg = read_config()
    _need(cfg, "openwrath", "sdk", "base_manifests", "schema", "mods_dir")
    if game_running() and not args.force:
        sys.exit("error: Kane's Wrath appears to be RUNNING. Baking swaps its data file out from under\n"
                 "       the live game and WILL freeze it. Close the game first, then re-run "
                 "(or pass --force if you know what you're doing).")
    print(f"baking '{name}' -> {target}\n")

    work = Path(tempfile.mkdtemp(prefix="openwrath-bake-"))
    try:
        # 1. compile each source; collect the override assets it declares
        to_splice = []  # (tid, iid, asset_file, manifest)
        all_iids = set()
        for src in sources:
            want = set(declared_overrides(src))
            print(f"  compiling {src.name} ({len(want)} overrides: {', '.join(sorted(want))})")
            mf, assets = compile_source(cfg, src, work / src.stem)
            for e in parse_manifest(str(mf)):
                inst = (e["name"] or "").split(":", 1)[-1]
                if inst in want:
                    af = assets / f'{e["tid"]:08x}.{e["th"]:08x}.{e["iid"]:08x}.{e["ih"]:08x}.asset'
                    if af.exists():
                        to_splice.append((e["tid"], e["iid"], af, mf))
                        all_iids.add(e["iid"])
        if not to_splice:
            sys.exit("error: none of the declared overrides compiled to an asset.")

        # 2. resolve target big + the stream, and split overrides into replace (id present) vs insert (new)
        big, stream, stream_iids = find_target_big_and_stream(cfg, target, all_iids, spec.get("stream"))
        # Never bake FROM a corrupt base: a truncated source big would silently yield garbage overrides.
        if not big_is_complete(big):
            backup = big.with_suffix(".big.openwrath-backup")
            hint = (f" Restore it first: openwrath mod revert {target}" if backup.exists()
                    else " No backup found — reinstall the target mod.")
            sys.exit(f"error: the installed {big.name} is truncated/corrupt — refusing to bake from it.{hint}")
        replace = [(t, i, af, mf) for (t, i, af, mf) in to_splice if i in stream_iids]
        insert = [(t, i, af, mf) for (t, i, af, mf) in to_splice if i not in stream_iids]
        summary = f"{len(replace)} replaced" + (f", {len(insert)} new (inserted)" if insert else "")
        print(f"  target: {big.name}  stream: {stream}  ({summary})")

        # 3. extract that stream, then apply each override (chained): splice existing, insert new.
        cur = work / "extract"
        cur.mkdir()
        subprocess.run(["python3", str(LIB / "bigextract.py"), str(big), f"{stream}.", str(cur)],
                       capture_output=True)

        # SCHEMA-DRIFT GUARD (docs/findings/0010). Every asset entry carries a TypeHash = schema fingerprint;
        # the engine requires ONE per type across a stream. REPLACE is immune (splice keeps the stream's hash),
        # but an INSERT writes a NEW entry with OUR compiler's hash — and if the target stream diverged on that
        # type (built against a different schema version), the engine rejects the whole stream on LOAD. That is
        # a structurally-complete big that still crashes, so big_is_complete can't catch it: we must here.
        # Default = refuse with a precise message. With --adopt-schema, stamp the stream's hash instead (only
        # sound if the on-disk layout is identical and only the fingerprint drifted — verify in-game).
        adopt_th = {}  # tid -> stream's TypeHash, for inserts we are allowed to adopt
        if insert:
            stream_th = {}
            for e in parse_manifest(str(cur / f"{stream}.manifest")):
                stream_th.setdefault(e["tid"], e["th"])
            drifted = []
            for tid, iid, af, mf in insert:
                ins_th = int(af.name.split(".")[1], 16)   # asset filename = tid.th.iid.ih.asset
                exp = stream_th.get(tid)
                if exp is not None and exp != ins_th:
                    drifted.append((tid, iid, exp, ins_th))
            if drifted:
                detail = "\n".join(
                    f"       type 0x{t:08x}: stream uses 0x{e:08x}, compiler emits 0x{i:08x} "
                    f"(new asset 0x{ii:08x})" for (t, ii, e, i) in drifted)
                if not args.adopt_schema:
                    sys.exit(
                        "error: schema drift on INSERT — refusing (the game would reject the stream on load).\n"
                        + detail +
                        "\n       The target stream was built against a different schema version for these "
                        "type(s).\n       Inspect with:  openwrath schema --drift-only\n"
                        "       REPLACE is always safe. To INSERT anyway by adopting the stream's hash "
                        "(then verify\n       in-game), re-run with --adopt-schema.  "
                        "See docs/findings/0010-insert-must-match-target-stream-type-schema-hash.md")
                for (t, ii, e, i) in drifted:
                    adopt_th[t] = e
                print(f"  --adopt-schema: {len(drifted)} inserted asset(s) will adopt the stream's TypeHash "
                      f"(UNVERIFIED — test in-game):")
                for (t, ii, e, i) in drifted:
                    print(f"      0x{t:08x}: 0x{i:08x} -> 0x{e:08x}")

        step = 0
        for tid, iid, af, mf in replace:
            nxt = work / f"op{step}"; step += 1
            r = subprocess.run(["python3", str(LIB / "splice_asset.py"), str(cur), str(af),
                                str(mf), str(nxt), f"{tid:08x}", f"{iid:08x}"],
                               capture_output=True, text=True)
            if not (nxt / f"{stream}.manifest").exists():
                sys.exit(f"error: splice failed for {tid:08x}:{iid:08x}:\n{r.stdout}{r.stderr}")
            cur = nxt
        for tid, iid, af, mf in insert:
            nxt = work / f"op{step}"; step += 1
            cmd = ["python3", str(LIB / "insert_asset.py"), str(cur), str(af),
                   str(mf), str(nxt), stream, f"openwrath:{name}"]
            if tid in adopt_th:                       # adopt the stream's schema hash for this drifted type
                cmd += ["--type-hash", f"{adopt_th[tid]:08x}"]
            r = subprocess.run(cmd, capture_output=True, text=True)
            if not (nxt / f"{stream}.manifest").exists():
                sys.exit(f"error: insert failed for {tid:08x}:{iid:08x}:\n{r.stdout}{r.stderr}")
            cur = nxt

        # 4. repack a new big, verify it is complete, back up the live one, install, re-verify, else roll back.
        newbig = work / "patched.big"
        r = subprocess.run(["python3", str(LIB / "big_replace.py"), str(big), str(newbig),
                            *[f"data\\{stream}.{ext}={cur}/{stream}.{ext}"
                              for ext in ("manifest", "bin", "relo", "imp")]],
                           capture_output=True, text=True)
        if r.returncode != 0 or not newbig.exists():
            sys.exit(f"error: repack failed (exit {r.returncode}):\n{r.stdout}{r.stderr}")
        # A BIG4 is complete iff no entry's data extends past the file. This catches a truncated/short
        # repack BEFORE it can overwrite the installed archive.
        if not big_is_complete(newbig):
            sys.exit(f"error: repacked big is truncated/corrupt — refusing to install.\n{r.stdout}{r.stderr}")

        backup = big.with_suffix(".big.openwrath-backup")
        if not backup.exists():
            shutil.copy2(big, backup)
        # Install, then fsync + re-verify what actually landed on disk; roll back from backup on any problem.
        shutil.copy2(newbig, big)
        with open(big, "rb") as fh:
            os.fsync(fh.fileno())
        if not big_is_complete(big):
            shutil.copy2(backup, big)
            sys.exit("error: installed big failed its integrity check — ROLLED BACK from backup. "
                     "Nothing was changed; please retry.")
        print(f"\n  ✓ baked + verified intact. backup: {backup.name}")
        print(f"  revert anytime: openwrath mod revert {target}")
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


def cmd_mod_revert(args) -> int:
    import shutil
    cfg = read_config()
    (mods,) = _need(cfg, "mods_dir")
    if game_running() and not args.force:
        sys.exit("error: Kane's Wrath appears to be RUNNING — close it before reverting (or --force).")
    big = Path(mods) / args.target / "ada_1_Streams.big"
    backup = big.with_suffix(".big.openwrath-backup")
    if not backup.exists():
        sys.exit(f"error: no openwrath backup for {args.target} ({backup.name} missing).")
    if not big_is_complete(backup):
        sys.exit(f"error: the backup {backup.name} is itself truncated/corrupt — NOT restoring "
                 "(that would make things worse). The target mod likely needs a reinstall.")
    shutil.copy2(backup, big)
    with open(big, "rb") as fh:
        os.fsync(fh.fileno())
    if not big_is_complete(big):
        sys.exit("error: restore produced an incomplete big — disk problem? Re-run after freeing space.")
    print(f"reverted {args.target} to the pre-bake backup (verified intact).")
    return 0


# --- discovery: inspect / find / uses / trace --------------------------------------------
# These read the INSTALLED stream (what the game actually loads), so modders can explore the
# data graph instead of needing tribal knowledge of where everything lives. All are driven by
# a shared manifest index built from the target mod's big.

def _resolve_target_big(cfg: dict, target: str | None) -> tuple[Path, str]:
    """Return (ada_1_Streams.big path, target name). If target is None, auto-detect the sole
    installed mod; error (listing candidates) if there are zero or many."""
    (mods,) = _need(cfg, "mods_dir")
    mods = Path(mods)
    if target:
        big = mods / target / "ada_1_Streams.big"
        if not big.exists():
            sys.exit(f"error: no ada_1_Streams.big for target '{target}' at {big}")
        return big, target
    cands = [d for d in sorted(mods.iterdir()) if d.is_dir() and (d / "ada_1_Streams.big").exists()]
    if len(cands) == 1:
        return cands[0] / "ada_1_Streams.big", cands[0].name
    if not cands:
        sys.exit(f"error: no installed mod with an ada_1_Streams.big under {mods}")
    sys.exit("error: multiple installed mods — pass --target <name>: "
             + ", ".join(d.name for d in cands))


def our_type_hashes(cfg: dict) -> dict:
    """Parse the compiler's native type registry (XmlCompiler/Plugin.cs) into {TypeName: TypeHash}.

    This is the schema fingerprint OUR compiler stamps for each type — the retail Kane's Wrath hash. A mod
    stream built against a different schema version will carry a DIFFERENT hash for the same type (schema
    drift); comparing against this map is how `openwrath schema` flags those. Returns {} if Plugin.cs is
    missing. Handles both the plain `(typeof(X), 0xHASHu, ...)` entries and the
    `#if TIBERIUMWARS / #elif KANESWRATH / #endif` conditional ones (we keep the KANESWRATH branch — KW is
    the build target), and namespaced names (`SageBinaryData.Environment` -> `Environment`)."""
    import re
    (ow,) = _need(cfg, "openwrath")
    plugin = Path(ow) / "source/BinaryAssetBuilder.XmlCompiler/BinaryAssetBuilder/XmlCompiler/Plugin.cs"
    if not plugin.exists():
        vlog(f"Plugin.cs not found at {plugin} — drift column unavailable")
        return {}
    txt = plugin.read_text()
    # Drop the TIBERIUMWARS branch of each conditional so only the KANESWRATH hash remains before the entry.
    txt = re.sub(r"#if\s+TIBERIUMWARS.*?#elif\s+KANESWRATH", "", txt, flags=re.S).replace("#endif", "")
    out = {}
    for m in re.finditer(r"typeof\(([\w.]+)\)\s*,\s*0x([0-9A-Fa-f]+)u", txt):
        out[m.group(1).split(".")[-1]] = int(m.group(2), 16)
    vlog(f"parsed {len(out)} native type hashes from Plugin.cs")
    return out


def _extract(big: Path, needle: str, outdir: Path) -> None:
    import subprocess
    subprocess.run(["python3", str(LIB / "bigextract.py"), str(big), needle, str(outdir)],
                   capture_output=True)


def load_stream_index(cfg: dict, target: str | None, stream: str) -> dict:
    """Extract the stream's manifest (only — fast) and build an index of every asset:
    full name ('Type:Instance'), split type/inst, and outgoing (tid,iid) references.
    Returns {entries, by_iid, by_name, big, target, stream}."""
    import struct, tempfile, shutil, time
    big, target = _resolve_target_big(cfg, target)
    vlog(f"target: {target}  big: {big}  stream: {stream}")
    td = Path(tempfile.mkdtemp(prefix="openwrath-idx-"))
    t0 = time.time()
    try:
        _extract(big, f"{stream}.manifest", td)
        mp = td / f"{stream}.manifest"
        if not mp.exists() or mp.stat().st_size == 0:
            sys.exit(f"error: stream '{stream}' not found in {big.name} (extract empty). "
                     f"Streams live as data\\<stream>.manifest inside the big.")
        b = mp.read_bytes()
        h = struct.unpack_from("<11I", b, 4)
        n, arsz, rmsz = h[2], h[7], h[8]
        refbuf_start = MANIFEST_V5_HDR + n * MANIFEST_ENTRY       # AssetRefBuf begins after the entry table
        name_base = refbuf_start + arsz + rmsz                    # AssetNameBuf begins after ref + refManName bufs
        entries, by_iid, by_name = [], {}, {}
        for i in range(n):
            o = MANIFEST_V5_HDR + i * MANIFEST_ENTRY
            tid, iid, th, ih = struct.unpack_from("<4I", b, o)
            aro, arc = struct.unpack_from("<2i", b, o + 16)       # AssetReferenceOffset (bytes), Count
            noff = struct.unpack_from("<i", b, o + 24)[0]
            name = None
            if noff >= 0:
                p = name_base + noff
                name = b[p:b.index(b"\x00", p)].decode("latin1", "replace")
            if name and ":" in name:
                typ, inst = name.split(":", 1)
            else:
                typ, inst = None, name
            refs = []
            base = refbuf_start + aro
            for j in range(arc):
                rt, ri = struct.unpack_from("<2I", b, base + j * 8)  # each ref = (TypeId, InstanceId)
                refs.append((rt, ri))
            e = {"tid": tid, "iid": iid, "th": th, "ih": ih,
                 "name": name, "type": typ, "inst": inst, "refs": refs}
            entries.append(e)
            by_iid[iid] = e
            if inst:
                by_name.setdefault(inst.lower(), []).append(e)
        vlog(f"indexed {len(entries)} assets from {stream}.manifest  ({time.time()-t0:.2f}s)")
        return {"entries": entries, "by_iid": by_iid, "by_name": by_name,
                "big": big, "target": target, "stream": stream}
    finally:
        shutil.rmtree(td, ignore_errors=True)


def _resolve_asset(idx: dict, asset: str, want_type: str | None = None) -> list[dict]:
    """Resolve an instance name to its entries. Prefers an EXACT-case match (so 'NODAvatar' picks
    GameObject:NODAvatar, not a case-variant like OnDemandTextureImage:NodAvatar); falls back to the
    case-insensitive set only when there is no exact-case hit. When want_type is given, restricts
    to assets of that type (so `--type GameObject` disambiguates a name shared across types)."""
    hits = idx["by_name"].get(asset.lower())
    if not hits:
        sys.exit(f"error: '{asset}' not found in stream '{idx['stream']}' of {idx['target']}. "
                 f"Try: openwrath find {asset}")
    if want_type:
        wt = want_type.lower()
        typed = [e for e in hits if e["type"] and e["type"].lower() == wt]
        if not typed:
            avail = sorted({e["type"] for e in hits if e["type"]})
            sys.exit(f"error: no asset named '{asset}' of type '{want_type}'. "
                     f"Available type(s): {', '.join(avail) or '(untyped)'}")
        hits = typed
    exact = [e for e in hits if e["inst"] == asset]
    return exact if exact else hits


def cmd_find(args) -> int:
