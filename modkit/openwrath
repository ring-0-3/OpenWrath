#!/usr/bin/env python3
"""openwrath — developer modding CLI for the OpenWrath / Kane's Wrath toolchain.

A thin, config-driven orchestration layer over the OpenWrath compiler/decompiler and the
stream-surgery tools, so modding doesn't require tribal knowledge of where everything lives.

Design rules (hard):
  * NO path to any specific machine is baked into this code. Everything a user's setup
    needs is discovered at runtime (`detect`) or read from a per-user config. The only
    literals here are facts about the GAME (Steam appid, install folder name) — never a
    personal path.
  * Ships ZERO game data. It operates on the user's own install / SDK, which they own.
  * Config lives at $XDG_CONFIG_HOME/openwrath/config.toml (per-user, outside any repo),
    so there is nothing to gitignore and no path ever lands in version control.

Subcommands:
  init          guided setup: auto-detect, confirm bring-your-own paths, write the config (Enter-to-accept)
  detect        auto-discover this machine's KW install / prefix / mods / SDK and write the config
  show          print the resolved config and flag anything missing
  gen-stringhashes   build the master StringHashes.xml from your own SDK (compiles with -scd, merges)
  extract-manifests  extract + RefPack-decompress the base-stream manifests from your installed game
  mod bake      compile a mod's overrides + splice/insert them into a target stream, repack, install
  mod package   build a self-contained, shareable mod (own big + SkuDef) for Mods/ — ships zero EA content
  mod check     pre-flight validation (dangling refs / unknown fields / schema drift) with file:line
  mod revert    restore a target mod's big from the last openwrath backup
  inspect <a>   decompile + print ONE asset from the installed stream (what the game actually loads)
  find <text>   list installed assets whose name contains <text> (optionally --type)
  uses <a>      list assets that REFERENCE <a> (reverse refs — spot shared templates before editing)
  trace <a>     print <a>'s outgoing reference tree (unit -> weapons -> projectiles -> fx -> ...)
"""
import argparse
import os
import re
import sys
from pathlib import Path

# --- verbosity ---------------------------------------------------------------------------
# Diagnostics (resolved paths, cache hit/miss, timings, counts) go to STDERR and only when
# --verbose is set, so default stdout stays clean and pipeable.
_VERBOSE = False


def vlog(msg: str) -> None:
    if _VERBOSE:
        print(msg, file=sys.stderr)

# --- Game facts (NOT user paths; constants about Kane's Wrath itself) --------------------
APPID = "24810"
GAME_DIR_NAME = "Command and Conquer 3 - Kane's Wrath"   # steamapps/common/<this>
WINE_DOCS_NAME = "Command & Conquer 3 Kane's Wrath"       # drive_c/.../Documents/<this>
SKUDEF_GLOB = "CNC3EP1_english_*.SkuDef"                  # the launcher picks the highest version

CONFIG_PATH = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    / "openwrath" / "config.toml"
)


def _xdg_data_dir() -> Path:
    """Per-user data dir for things openwrath PRODUCES (the StringHashes table, extracted base
    manifests). XDG: $XDG_DATA_HOME/openwrath, else ~/.local/share/openwrath. Never a repo path."""
    base = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    return base / "openwrath"

# Keys we resolve, with a human description. Discovered keys are auto-filled by `detect`;
# "byo" (bring-your-own) keys are things only the user can point us at (their SDK, etc.).
SCHEMA = [
    ("steam_root",     "auto", "Steam root (Flatpak / native)"),
    ("game_install",   "auto", "KW install dir (holds CNC3EP1.exe + the master SkuDef)"),
    ("prefix",         "auto", "Proton/Wine prefix for KW"),
    ("mods_dir",       "auto", "Where mods are installed (Wine Documents/.../Mods)"),
    ("install_skudef", "auto", "Active master SkuDef the launcher reads"),
    ("openwrath",      "auto", "OpenWrath toolchain dir (this repo; holds Debug/)"),
    ("sdk",            "byo",  "Kane's Wrath XML SDK (KanesWrathXMLFiles) — you provide"),
    ("base_manifests", "byo",  "SDK 'Game Files/Manifest' dir (global/static manifests)"),
    ("schema",         "byo",  "CnC3Types.xsd schema"),
    ("stringhashes",   "byo",  "master StringHashes.xml (EA-derived; you generate/provide)"),
]


# --- tiny TOML writer (flat [paths] table of strings; avoids a write-dep) ----------------
def write_config(cfg: dict) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "# openwrath config — per-user, auto-written by `openwrath detect`.",
        "# Edit freely; re-run `openwrath detect` to re-discover the 'auto' paths.",
        "",
        "[paths]",
    ]
    for key, _, desc in SCHEMA:
        val = cfg.get(key, "") or ""
        lines.append(f'{key} = "{val}"' + (f"   # {desc}" if not val else ""))
    CONFIG_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")


def read_config() -> dict:
    if not CONFIG_PATH.exists():
        return {}
    import tomllib
    with open(CONFIG_PATH, "rb") as f:
        return tomllib.load(f).get("paths", {})


# --- WSL awareness -----------------------------------------------------------------------
# Under WSL the game is a native WINDOWS app living on a Windows drive, mounted at /mnt/<letter>.
# There is no Proton/Wine prefix; the Mods dir is in the Windows user's Documents. These helpers
# add that as an ADDITIONAL detection branch — native Linux (Flatpak/Proton) is untouched.
WSL_MNT = Path("/mnt")   # where Windows drives mount under WSL (module-level so tests can redirect)


def is_wsl() -> bool:
    """True when running under the Windows Subsystem for Linux."""
    try:
        if "microsoft" in os.uname().release.lower() or "wsl" in os.uname().release.lower():
            return True
    except Exception:
        pass
    try:
        v = Path("/proc/version").read_text(errors="replace").lower()
        return "microsoft" in v or "wsl" in v
    except Exception:
        return False


def windows_drives() -> list[Path]:
    """Existing /mnt/<letter> Windows-drive mounts (empty off WSL / when none are mounted)."""
    if not WSL_MNT.exists():
        return []
    return sorted(p for p in WSL_MNT.iterdir()
                  if p.is_dir() and len(p.name) == 1 and p.name.isalpha())


def winpath_to_mnt(winpath: str) -> Path:
    """Translate a Windows path ('C:\\Program Files\\Steam') to its WSL mount ('/mnt/c/...').
    Leaves a non-Windows path unchanged, so this is safe to apply unconditionally."""
    m = re.match(r"^([A-Za-z]):[\\/](.*)$", winpath)
    if not m:
        return Path(winpath)
    return WSL_MNT / m.group(1).lower() / m.group(2).replace("\\", "/")


# --- Steam / prefix discovery ------------------------------------------------------------
def steam_roots() -> list[Path]:
    home = Path.home()
    candidates = [
        home / ".var/app/com.valvesoftware.Steam/.local/share/Steam",  # Flatpak
        home / ".local/share/Steam",                                   # native
        home / ".steam/steam",
        home / ".steam/root",
    ]
    if is_wsl():
        for drive in windows_drives():                                 # Windows-side Steam
            candidates += [drive / "Program Files (x86)/Steam",
                           drive / "Program Files/Steam"]
    seen, out = set(), []
    for c in candidates:
        rp = c.resolve() if c.exists() else c
        if c.exists() and rp not in seen:
            seen.add(rp)
            out.append(c)
    return out


def library_paths(steam_root: Path) -> list[Path]:
    """Every Steam library folder (games may live on other drives), from libraryfolders.vdf.
    Windows-style paths in the .vdf (as under WSL) are translated to their /mnt mount."""
    libs = [steam_root]
    for vdf in (steam_root / "steamapps/libraryfolders.vdf",
                steam_root / "config/libraryfolders.vdf"):
        if vdf.exists():
            for m in re.finditer(r'"path"\s*"([^"]+)"', vdf.read_text(errors="replace")):
                raw = m.group(1).replace("\\\\", "\\")   # .vdf escapes backslashes
                p = winpath_to_mnt(raw) if re.match(r"^[A-Za-z]:", raw) else Path(raw)
                if p not in libs:
                    libs.append(p)
    return libs


def find_install_and_prefix() -> tuple[Path | None, Path | None, Path | None]:
    """Return (steam_root, game_install, prefix) for appid 24810, or Nones."""
    for root in steam_roots():
        for lib in library_paths(root):
            install = lib / "steamapps/common" / GAME_DIR_NAME
            prefix = lib / "steamapps/compatdata" / APPID / "pfx"
            if install.exists():
                return root, install, (prefix if prefix.exists() else None)
    return None, None, None


def find_mods_dir(prefix: Path) -> Path | None:
    docs = prefix / "drive_c/users/steamuser/Documents" / WINE_DOCS_NAME / "Mods"
    return docs if docs.exists() else None


def find_mods_dir_wsl() -> Path | None:
    """On WSL there is no Wine prefix — the Mods dir lives in the Windows user's Documents.
    Scan /mnt/<drive>/Users/<user>/Documents/<game>/Mods, skipping the built-in accounts."""
    skip = {"Public", "Default", "All Users", "Default User"}
    for drive in windows_drives():
        users = drive / "Users"
        if not users.exists():
            continue
        for ud in sorted(users.iterdir()):
            if not ud.is_dir() or ud.name in skip:
                continue
            docs = ud / "Documents" / WINE_DOCS_NAME / "Mods"
            if docs.exists():
                return docs
    return None


def find_install_skudef(install: Path) -> Path | None:
    """The launcher reads the highest-version english SkuDef; pick that one."""
    skus = sorted(install.glob(SKUDEF_GLOB))
    def ver(p: Path):
        m = re.search(r"_(\d+)\.(\d+)\.SkuDef$", p.name)
        return (int(m.group(1)), int(m.group(2))) if m else (0, 0)
    return max(skus, key=ver) if skus else None


def openwrath_dir() -> Path:
    """This repo (the CLI lives in <repo>/modkit/openwrath)."""
    return Path(__file__).resolve().parent.parent


def probe_byo(repo: Path) -> dict:
    """Best-effort guesses for bring-your-own paths — only used to pre-fill; never required."""
    home = Path.home()
    out = {}
    for sdk in (home / "cnc-kw-sdk/KanesWrathXMLFiles",):
        if sdk.exists():
            out["sdk"] = str(sdk)
            mani = sdk.parent / "Game Files/Manifest"
            if mani.exists():
                out["base_manifests"] = str(mani)
            break
    sch = repo / "schemas/kw/xsd/CnC3Types.xsd"
    if sch.exists():
        out["schema"] = str(sch)
    return out


# --- commands ----------------------------------------------------------------------------
def cmd_detect(_args) -> int:
    print("openwrath detect — discovering your Kane's Wrath setup...\n")
    cfg = read_config()  # keep any values the user already set
    root, install, prefix = find_install_and_prefix()
    repo = openwrath_dir()

    found = dict(cfg)
    if root:    found["steam_root"] = str(root)
    if install: found["game_install"] = str(install)
    if prefix:  found["prefix"] = str(prefix)
    if prefix and (mods := find_mods_dir(prefix)):
        found["mods_dir"] = str(mods)
    elif is_wsl() and (mods := find_mods_dir_wsl()):
        found["mods_dir"] = str(mods)
    if install and (sku := find_install_skudef(install)): found["install_skudef"] = str(sku)
    found["openwrath"] = str(repo)
    for k, v in probe_byo(repo).items():
        found.setdefault(k, v)

    write_config(found)

    missing = [k for k, kind, _ in SCHEMA if not found.get(k)]
    for key, kind, desc in SCHEMA:
        val = found.get(key, "")
        mark = "ok " if val else ("-- " if kind == "byo" else "!! ")
        print(f"  [{mark}] {key:15} {val or '(not found — ' + desc + ')'}")
    print(f"\nconfig written -> {CONFIG_PATH}")
    if missing:
        byo = [k for k in missing if dict((s[0], s[1]) for s in SCHEMA)[k] == "byo"]
        auto = [k for k in missing if k not in byo]
        if auto:
            print(f"\n  ⚠ could not auto-detect: {', '.join(auto)} — set them in the config above.")
        if byo:
            print(f"  → bring-your-own (point these at your own files): {', '.join(byo)}")
    return 0


def cmd_show(_args) -> int:
    cfg = read_config()
    if not cfg:
        print(f"no config at {CONFIG_PATH} — run `openwrath detect` first.")
        return 1
    print(f"config: {CONFIG_PATH}\n")
    for key, kind, desc in SCHEMA:
        val = cfg.get(key, "")
        exists = " " if not val else ("ok" if Path(val).exists() else "MISSING-ON-DISK")
        print(f"  {key:15} [{exists:>15}]  {val}")
    return 0


# --- mod bake: compile overrides -> splice into a target stream -> repack -> install -------
LIB = Path(__file__).resolve().parent / "lib"
MANIFEST_V5_HDR = 48
MANIFEST_ENTRY = 44


def _need(cfg: dict, *keys) -> list[str]:
    import tomllib  # noqa: F401  (ensures 3.11+)
    vals = []
    for k in keys:
        v = cfg.get(k)
        if not v or not Path(v).exists():
            sys.exit(f"error: config '{k}' is unset or missing on disk — run `openwrath detect` "
                     f"(or set it in {CONFIG_PATH}).")
        vals.append(v)
    return vals


def parse_manifest(path: str) -> list[dict]:
    """Parse a v5 linked-stream manifest into per-asset dicts (incl. qualified name)."""
    import struct
    b = Path(path).read_bytes()
    h = struct.unpack_from("<11I", b, 4)
    n, arsz, rmsz, ansz = h[2], h[7], h[8], h[9]
    name_base = MANIFEST_V5_HDR + n * MANIFEST_ENTRY + arsz + rmsz
    out = []
    for i in range(n):
        o = MANIFEST_V5_HDR + i * MANIFEST_ENTRY
        tid, iid, th, ih = struct.unpack_from("<4I", b, o)
        noff = struct.unpack_from("<i", b, o + 24)[0]
        name = None
        if noff >= 0:
            p = name_base + noff
            name = b[p:b.index(b"\x00", p)].decode("latin1", "replace")
        out.append({"tid": tid, "iid": iid, "th": th, "ih": ih, "name": name})
    return out


def declared_overrides(source_xml: Path) -> list[str]:
    """Instance ids the mod itself declares as top-level overrides (not inside <Includes>)."""
    import xml.etree.ElementTree as ET
    root = ET.parse(source_xml).getroot()
    skip = {"Tags", "Includes"}
    ids = []
    for child in root:
        tag = child.tag.split("}")[-1]
        if tag in skip:
            continue
        cid = child.get("id")
        if cid:
            ids.append(cid)
    return ids


def game_running() -> bool:
    """True if the Kane's Wrath EXECUTABLE is running — swapping its big out from under it freezes it.

    Matches the game exe (cnc3ep1.dat/.exe) specifically, not mere path mentions (Steam wrappers,
    our own tooling, or a shell command that happens to name the game) — those are filtered out.
    """
    import subprocess
    r = subprocess.run(["pgrep", "-afi", r"cnc3ep1\.(dat|exe)"], capture_output=True, text=True)
    if r.returncode != 0:
        return False
    ours = ("openwrath", "modkit", "pgrep", "bab-decompile", "BinaryAssetBuilder",
            "splice_asset.py", "big_replace.py", "bigextract.py")
    return any(ln.strip() and not any(o in ln for o in ours) for ln in r.stdout.splitlines())


def _dotnet_env() -> dict:
    """Environment for invoking the .NET toolchain (BAB / bab-decompile / roundtrip.sh).

    Ensures the per-user profile bin (where `dotnet` lives) is on PATH and the roll-forward
    knobs are set, without baking a personal path: the per-user profile dir is a NixOS fact,
    added only if present so this stays a no-op elsewhere."""
    env = dict(os.environ, DOTNET_ROLL_FORWARD="LatestMajor",
               DOTNET_ROLL_FORWARD_TO_PRERELEASE="1",
               DOTNET_CLI_TELEMETRY_OPTOUT="1", DOTNET_NOLOGO="1")
    peruser = f"/etc/profiles/per-user/{os.environ.get('USER', '')}/bin"
    if os.path.isdir(peruser) and peruser not in env.get("PATH", "").split(os.pathsep):
        env["PATH"] = peruser + os.pathsep + env.get("PATH", "")
    return env


def _run(cmd: list[str], **kw):
    import subprocess
    return subprocess.run(cmd, env=_dotnet_env(), **kw)


# --- session cache for extracted streams -------------------------------------------------
# Extracting a full stream (manifest + the big .bin/.relo/.imp) from a BIG is slow, so cache
# the extracted files per (big, stream) under $XDG_CACHE_HOME/openwrath, keyed on the big's
# mtime+size. If the big changes (mtime or size differs) the signature changes and we extract
# afresh — correctness first. inspect/verify use this; find/uses/trace keep their fast
# manifest-only extraction.
def _cache_root() -> Path:
    base = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    return base / "openwrath"


def _big_sig(big: Path) -> str:
    st = big.stat()
    return f"{st.st_mtime_ns}-{st.st_size}"


_STREAM_EXTS = ("manifest", "bin", "relo", "imp")


def ensure_stream_cache(big: Path, stream: str, label: str,
                        no_cache: bool = False) -> tuple[Path, bool]:
    """Return (dir containing <stream>.{manifest,bin,relo,imp}, cache_hit).

    With no_cache, extract to a throwaway temp dir (caller may leave it; it lands in the OS
    temp). Otherwise populate a stable per-(big,stream,signature) cache dir and reuse it when a
    completion marker proves a prior extraction finished for this exact big."""
    import tempfile, time
    if no_cache:
        d = Path(tempfile.mkdtemp(prefix="openwrath-nocache-"))
        t0 = time.time()
        _extract(big, f"{stream}.", d)
        vlog(f"  extract (no-cache) {stream} from {big} -> {d}  ({time.time()-t0:.2f}s)")
        return d, False

    sig = _big_sig(big)
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", label) or "target"
    d = _cache_root() / f"{safe}-{stream}-{sig}"
    marker = d / ".complete"
    man = d / f"{stream}.manifest"
    if marker.exists() and man.exists() and man.stat().st_size > 0:
        vlog(f"  stream cache HIT: {d}")
        return d, True

    vlog(f"  stream cache MISS: {d}")
    d.mkdir(parents=True, exist_ok=True)
    t0 = time.time()
    _extract(big, f"{stream}.", d)
    if not man.exists() or man.stat().st_size == 0:
        sys.exit(f"error: could not extract stream '{stream}' from {big.name} "
                 f"(no {stream}.manifest produced).")
    marker.write_text(sig, encoding="utf-8")
    vlog(f"  extracted {stream} from {big} -> {d}  ({time.time()-t0:.2f}s)")
    return d, False


def _compile_cmd(cfg: dict, source: Path, outdir: Path) -> list[str]:
    """The .NET compile command for one override/overlay source → a linked `_mod` stream.

    `-bps`/`-rm` make the base streams available so any referenced base asset resolves as an
    IMPORT (not an embedded local copy); `-cpf:_mod` gives the output its overlay postfix. Shared
    by `compile_source` (bake), `cmd_mod_package` (overlay), and `cmd_mod_check` (validation) so the
    one compile invocation is defined once (single source of truth)."""
    bab = Path(cfg["openwrath"]) / "Debug/BinaryAssetBuilder.dll"
    bm = Path(cfg["base_manifests"])
    rm = f'{bm/"global_common_2.manifest"};{bm/"static_common_2.manifest"}'
    return ["dotnet", str(bab), str(source), f'-dr:{cfg["sdk"]}', f'-data:{cfg["sdk"]}',
            f"-od:{outdir}", f'-sp:{cfg["schema"]}', f'-bps:{bm/"static_common_2.manifest"}',
            f"-rm:{rm}", "-ls:true", "-cpf:_mod", "-sc:false", "-bc:false"]


def compile_source(cfg: dict, source: Path, outdir: Path) -> tuple[Path, Path]:
    """Compile one override XML; return (stream_manifest, assets_dir)."""
    import glob
    outdir.mkdir(parents=True, exist_ok=True)
    r = _run(_compile_cmd(cfg, source, outdir), capture_output=True, text=True)
    manifests = glob.glob(str(outdir / "*_mod.manifest"))
    if not manifests:
        sys.exit(f"error: compile produced no stream for {source.name}:\n{r.stdout[-800:]}")
    mf = Path(manifests[0])
    return mf, mf.with_suffix("") / "assets"


def big_is_complete(path) -> bool:
    """A BIG4 archive is complete iff no file-table entry's data extends past the physical file.
    Cheap structural check (reads only the header/table) that catches a truncated or short-written big
    before it is installed or trusted."""
    import struct
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            if f.read(4) != b"BIG4":
                return False
            f.seek(8)
            count, _firstoff = struct.unpack(">II", f.read(8))
            max_end = 0
            for _ in range(count):
                off, sz = struct.unpack(">II", f.read(8))
                name = b""
                while not name.endswith(b"\x00"):
                    ch = f.read(1)
                    if not ch:
                        return False
                    name += ch
                max_end = max(max_end, off + sz)
        return max_end <= size
    except Exception:
        return False


def find_target_big_and_stream(cfg: dict, target: str, override_iids: set[int],
                               stream_opt: str | None) -> tuple[Path, str, set[int]]:
    """Resolve the .big to patch, which linked stream to use, and that stream's existing instance ids.

    Returns (big, stream, stream_iids). The caller splits override ids by membership in stream_iids:
    ids already present are REPLACED (splice), ids not present are ADDED (insert) — so a mod can ship
    brand-new assets, not only tweak existing ones.

    If mod.toml pins `stream`, use it (new ids are fine — they get inserted). Otherwise pick the stream
    that already holds the most of the override ids; if some ids are new, the stream must be pinned so we
    know where to add them.
    """
    import subprocess, tempfile
    if target.lower() == "base":
        sys.exit("error: target='base' not supported yet — target an installed mod for now.")
    big = Path(cfg["mods_dir"]) / target / "ada_1_Streams.big"
    if not big.exists():
        sys.exit(f"error: target mod big not found: {big}")

    def iids_of(st: str) -> set[int]:
        with tempfile.TemporaryDirectory() as td:
            subprocess.run(["python3", str(LIB / "bigextract.py"), str(big), f"{st}.manifest", td],
                           capture_output=True)
            mp = Path(td) / f"{st}.manifest"
            return {e["iid"] for e in parse_manifest(str(mp))} if mp.exists() else set()

    if stream_opt:
        got = iids_of(stream_opt)
        if not got:
            sys.exit(f"error: stream '{stream_opt}' not found in {big.name}.")
        return big, stream_opt, got

    listing = subprocess.run(["python3", str(LIB / "biglist.py"), str(big), "manifest"],
                             capture_output=True, text=True).stdout
    streams = sorted({re.search(r"data.(\w+)\.manifest", ln).group(1)
                      for ln in listing.splitlines() if ".manifest" in ln and "cdata" not in ln})
    best = None  # (overlap_count, stream, iids)
    for st in streams:
        got = iids_of(st)
        if override_iids <= got:
            return big, st, got                 # contains ALL ids -> definitive
        overlap = len(override_iids & got)
        if overlap and (best is None or overlap > best[0]):
            best = (overlap, st, got)
    if best:
        _, st, got = best
        if not override_iids <= got:
            sys.exit(f"error: some override ids are NEW (not in any single stream). Pin the target stream in\n"
                     f"       mod.toml ([mod] stream = \"{st}\") so openwrath knows where to insert them.")
        return big, st, got
    sys.exit(f"error: none of {big.name}'s streams contain the override ids — is the target right?")


def _read_mod_spec(proj: Path) -> dict:
    """Load a project's [mod] table, or exit with a clear error if there's no mod.toml."""
    import tomllib
    toml = proj / "mod.toml"
    if not toml.exists():
        sys.exit(f"error: no mod.toml in {proj}. Create one with: openwrath mod new {proj.name}")
    return tomllib.loads(toml.read_text()).get("mod", {})


def _write_mod_spec(proj: Path, spec: dict) -> None:
    """Write a project's mod.toml from a [mod] spec dict (name / target / stream / sources)."""
    lines = ["[mod]"]
    for key in ("name", "target", "stream"):
        if spec.get(key) is not None:
            lines.append(f'{key} = "{spec[key]}"')
    srcs = spec.get("sources", [])
    lines.append("sources = [" + ", ".join(f'"{s}"' for s in srcs) + "]")
    (proj / "mod.toml").write_text("\n".join(lines) + "\n", encoding="utf-8")


def _data_relpath(cfg: dict, abspath: Path) -> str:
    """An SDK file's absolute path -> a `DATA:<relative>` include source (relative to the data root)."""
    sdk = Path(cfg["sdk"]).resolve()
    rel = Path(abspath).resolve().relative_to(sdk)
    return "DATA:" + str(rel).replace("\\", "/")


def _type_drift(cfg: dict, tag: str, target: str, stream: str):
    """Best-effort: is type `tag` schema-drifted in the target stream vs our compiler? Returns
    (status, our_hash, [stream_hashes]) or None if it couldn't be determined (never raises —
    this is advisory). status in {match, drift, mixed, unregistered, absent}."""
    try:
        our_h = our_type_hashes(cfg).get(tag)
        idx = load_stream_index(cfg, target, stream)
        sh = sorted({e["th"] for e in idx["entries"] if e["type"] == tag})
    except (SystemExit, Exception):   # advisory — if the stream can't be read, just skip the check
        return None
    if not sh:
        return ("absent", our_h, [])
    if len(sh) > 1:
        return ("mixed", our_h, sh)
    if our_h is None:
        return ("unregistered", our_h, sh)
    return (("match" if our_h == sh[0] else "drift"), our_h, sh)


def cmd_mod_new(args) -> int:
    """Scaffold a new mod project: a mod.toml + an empty src/ dir."""
    proj = Path(args.project).resolve()
    if (proj / "mod.toml").exists():
        sys.exit(f"error: {proj / 'mod.toml'} already exists")
    (proj / "src").mkdir(parents=True, exist_ok=True)
    spec = {"name": args.name or proj.name,
            "target": args.target or "",
            "stream": args.stream,
            "sources": []}
    _write_mod_spec(proj, spec)
    print(f"created mod project: {proj}")
    print(f"  mod.toml  (name={spec['name']}, target={spec['target'] or '<<set me>>'}, stream={spec['stream']})")
    print("  src/      (empty)")
    print()
    if not spec["target"]:
        print("next: set `target` in mod.toml to the installed mod to bake into (e.g. SecondIsomer), then:")
    else:
        print("next:")
    print(f"  openwrath mod add {proj.name} <AssetName>   # pull an asset in as an editable override")
    return 0


def cmd_mod_add(args) -> int:
    """Pull an asset into a project as an editable override, taken from the SDK *source*
    (not the installed binary — the SDK form always reads and sidesteps decompiler read-gaps)."""
    import subprocess
    proj = Path(args.project).resolve()
    spec = _read_mod_spec(proj)
    cfg = read_config()
    (sdk,) = _need(cfg, "sdk")
    inst, want_type = args.asset, args.type

    # Locate the asset's authoring XML in the SDK — same engine as `inspect --source`.
    r = subprocess.run(["grep", "-rlF", f'id="{inst}"', sdk], capture_output=True, text=True)
    files = [f for f in r.stdout.splitlines() if f]
    if not files:
        sys.exit(f"error: no SDK source under {sdk} declares id=\"{inst}\". Try: openwrath find {inst}")
    files.sort(key=lambda f: ("/maps/" in f.lower(), f))   # prefer authoring files over maps
    hit = None
    for fp in files:
        lines = Path(fp).read_text(encoding="utf-8", errors="replace").splitlines()
        found = _find_toplevel_block(lines, inst, want_type)
        if found:
            tag, start, end = found
            hit = (fp, tag, lines[start:end + 1])
            break
    if not hit:
        hint = f" of type '{want_type}'" if want_type else ""
        sys.exit(f"error: found id=\"{inst}\" in the SDK but no enclosing top-level asset{hint} "
                 f"(it may only appear as a nested reference).")
    fp, tag, body = hit
    inc = _data_relpath(cfg, Path(fp))

    srcrel = f"src/{inst}.xml"
    out = proj / srcrel
    if out.exists() and not args.force:
        sys.exit(f"error: {out} already exists (pass --force to overwrite).")
    override = "\n".join([
        '<?xml version="1.0" encoding="utf-8"?>',
        '<AssetDeclaration',
        '\txmlns="uri:ea.com:eala:asset"',
        '\txmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"',
        '\txmlns:xi="http://www.w3.org/2001/XInclude"',
        '\txmlns:xai="uri:ea.com:eala:asset:instance">',
        '',
        '\t<Tags/>',
        '\t<Includes>',
        f'\t\t<Include type="instance" source="{inc}" />',
        '\t</Includes>',
        '',
        f'\t<!-- Override {tag} "{inst}" in place. inheritFrom itself keeps every original field,',
        '\t     so you only list what you change below. (The current definition was printed when',
        f'\t     this file was created; re-print it any time with `openwrath inspect {inst}`.) -->',
        f'\t<{tag} id="{inst}" inheritFrom="{inst}">',
        '\t\t<!-- e.g. change an attribute or add a child element here -->',
        f'\t</{tag}>',
        '',
        '</AssetDeclaration>',
        '',
    ])
    out.write_text(override, encoding="utf-8")

    srcs = spec.get("sources", [])
    if srcrel not in srcs:
        srcs.append(srcrel)
        spec["sources"] = srcs
        _write_mod_spec(proj, spec)

    print(f"added {tag} \"{inst}\" to {proj.name}")
    print(f"  wrote {srcrel}  (inheritFrom-self override — edit the body, then `openwrath mod bake {proj.name}`)")
    print(f"  from  {fp}")

    # Advisory schema-drift check, surfaced here (at add time) rather than discovered at bake time: this
    # override is authored from the retail schema, so for a type the target stream diverged on, the baked
    # replace may not match the stream's layout.
    target = spec.get("target")
    if target:
        d = _type_drift(cfg, tag, target, spec.get("stream") or "static_mod")
        if d and d[0] in ("drift", "mixed"):
            status, our_h, sh = d
            shs = "/".join(f"0x{h:08x}" for h in sh)
            ohs = f"0x{our_h:08x}" if our_h is not None else "—"
            print()
            print(f"  ⚠ {tag} is schema-{status} in {target} (stream {shs} vs our {ohs}).")
            print(f"    This override is authored from the retail schema; for a drifted type the baked replace")
            print(f"    may not match the stream's layout for {tag} — verify in-game.  (openwrath schema --drift-only)")

    print()
    print("current definition (copy the field you want to change into the override body):")
    print("\n".join("    " + l for l in body))
    return 0


def _insert_drift_guard(insert: list, stream_manifest: Path, adopt_schema: bool) -> dict:
    """The finding-0010 schema-drift guard, shared by `mod bake` and `mod build-local` so the policy
    (and the manifest-format knowledge it rests on) lives in ONE place.

    Every asset entry carries a TypeHash = schema fingerprint; the engine requires ONE per type across a
    stream. REPLACE is immune (splice keeps the stream's hash), but an INSERT writes a NEW entry with OUR
    compiler's hash — if the target stream diverged on that type the engine rejects the whole stream on
    LOAD (a structurally-complete big that still crashes, so `big_is_complete` can't catch it). Default =
    refuse with a precise message. With `adopt_schema`, stamp the stream's hash instead (sound only if the
    on-disk layout is identical and only the fingerprint drifted — verify in-game). Returns `adopt_th`
    {tid -> stream TypeHash} for the inserts allowed to adopt (empty when nothing drifts)."""
    adopt_th: dict = {}
    if not insert:
        return adopt_th
    stream_th: dict = {}
    for e in parse_manifest(str(stream_manifest)):
        stream_th.setdefault(e["tid"], e["th"])
    drifted = []
    for tid, iid, af, mf in insert:
        ins_th = int(af.name.split(".")[1], 16)   # asset filename = tid.th.iid.ih.asset
        exp = stream_th.get(tid)
        if exp is not None and exp != ins_th:
            drifted.append((tid, iid, exp, ins_th))
    if drifted:
        detail = "\n".join(
            f"       type 0x{t:08x}: stream uses 0x{e:08x}, compiler emits 0x{i:08x} "
            f"(new asset 0x{ii:08x})" for (t, ii, e, i) in drifted)
        if not adopt_schema:
            sys.exit(
                "error: schema drift on INSERT — refusing (the game would reject the stream on load).\n"
                + detail +
                "\n       The target stream was built against a different schema version for these "
                "type(s).\n       Inspect with:  openwrath schema --drift-only\n"
                "       REPLACE is always safe. To INSERT anyway by adopting the stream's hash "
                "(then verify\n       in-game), re-run with --adopt-schema.  "
                "See docs/findings/0010-insert-must-match-target-stream-type-schema-hash.md")
        for (t, ii, e, i) in drifted:
            adopt_th[t] = e
        print(f"  --adopt-schema: {len(drifted)} inserted asset(s) will adopt the stream's TypeHash "
              f"(UNVERIFIED — test in-game):")
        for (t, ii, e, i) in drifted:
            print(f"      0x{t:08x}: 0x{i:08x} -> 0x{e:08x}")
    return adopt_th


def _apply_overrides(work: Path, cur: Path, stream: str, name: str,
                     replace: list, insert: list, adopt_th: dict) -> Path:
    """Chain the override ops over an extracted stream dir `cur`: splice each REPLACE, insert each new
    asset, returning the final dir. Shared by `mod bake` and `mod build-local`; reuses
    `lib/splice_asset.py` / `lib/insert_asset.py` (the single source of the manifest/bin/relo/imp format)
    rather than re-deriving it. (Those tools operate on `static_mod.*`-named files, so `cur` must hold the
    stream under that normalized name — the caller arranges it.)"""
    import subprocess, shutil
    # A linked stream dir is only usable if ALL FOUR parallel files exist — a splice/insert that writes the
    # manifest but dies before .relo/.imp (e.g. disk full) leaves a partial dir that fails OPAQUELY in the *next*
    # step. Check the full set here so a partial write is caught at its source with the producer's own stderr.
    def _complete(d: Path) -> bool:
        return all((d / f"{stream}.{ext}").exists() for ext in ("manifest", "bin", "relo", "imp"))
    # Each op step writes a FULL copy of the ~400 MB stream; keeping all N (one per override) needs N×400 MB of
    # temp (tens of GB for a large mod → disk-full). Delete each intermediate op dir once the next supersedes it,
    # bounding temp to ~2 copies regardless of override count. Never delete the caller's input dir (`cur`).
    base_in = cur
    step = 0

    def _advance(prev, nxt):
        if prev is not base_in and str(prev).startswith(str(work)):
            shutil.rmtree(prev, ignore_errors=True)
        return nxt

    for tid, iid, af, mf in replace:
        nxt = work / f"op{step}"; step += 1
        r = subprocess.run(["python3", str(LIB / "splice_asset.py"), str(cur), str(af),
                            str(mf), str(nxt), f"{tid:08x}", f"{iid:08x}"],
                           capture_output=True, text=True)
        if not _complete(nxt):
            sys.exit(f"error: splice failed for {tid:08x}:{iid:08x} (incomplete stream dir):\n{r.stdout}{r.stderr}")
        cur = _advance(cur, nxt)
    for tid, iid, af, mf in insert:
        nxt = work / f"op{step}"; step += 1
        cmd = ["python3", str(LIB / "insert_asset.py"), str(cur), str(af),
               str(mf), str(nxt), stream, f"openwrath:{name}"]
        if tid in adopt_th:                       # adopt the stream's schema hash for this drifted type
            cmd += ["--type-hash", f"{adopt_th[tid]:08x}"]
        r = subprocess.run(cmd, capture_output=True, text=True)
        if not _complete(nxt):
            sys.exit(f"error: insert failed for {tid:08x}:{iid:08x} (incomplete stream dir):\n{r.stdout}{r.stderr}")
        cur = _advance(cur, nxt)
    return cur


def cmd_mod_bake(args) -> int:
    import tomllib, tempfile, shutil, glob, subprocess
    proj = Path(args.project).resolve()
    toml = proj / "mod.toml"
    if not toml.exists():
        sys.exit(f"error: no mod.toml in {proj}")
    spec = tomllib.loads(toml.read_text()).get("mod", {})
    name = spec.get("name", proj.name)
    target = spec.get("target") or sys.exit("error: mod.toml needs [mod] target = \"<ModName>\"")
    sources = [proj / s for s in spec.get("sources", [])] or sys.exit("error: mod.toml needs sources")

    cfg = read_config()
    _need(cfg, "openwrath", "sdk", "base_manifests", "schema", "mods_dir")
    if game_running() and not args.force:
        sys.exit("error: Kane's Wrath appears to be RUNNING. Baking swaps its data file out from under\n"
                 "       the live game and WILL freeze it. Close the game first, then re-run "
                 "(or pass --force if you know what you're doing).")
    # Pre-flight validation runs automatically before a bake (dangling refs / unknown fields /
    # schema drift) so problems surface with file/line up front rather than as a mid-bake crash.
    if not getattr(args, "no_check", False):
        print("pre-flight check:")
        if run_mod_check(cfg, proj, quiet=False):
            sys.exit("error: pre-flight check found problems (above) — fix them or re-run with "
                     "--no-check to bake anyway.")
        print()
    print(f"baking '{name}' -> {target}\n")

    work = Path(tempfile.mkdtemp(prefix="openwrath-bake-"))
    try:
        # 1. compile each source; collect the override assets it declares
        to_splice = []  # (tid, iid, asset_file, manifest)
        all_iids = set()
        for src in sources:
            want = set(declared_overrides(src))
            print(f"  compiling {src.name} ({len(want)} overrides: {', '.join(sorted(want))})")
            mf, assets = compile_source(cfg, src, work / src.stem)
            for e in parse_manifest(str(mf)):
                inst = (e["name"] or "").split(":", 1)[-1]
                if inst in want:
                    af = assets / f'{e["tid"]:08x}.{e["th"]:08x}.{e["iid"]:08x}.{e["ih"]:08x}.asset'
                    if af.exists():
                        to_splice.append((e["tid"], e["iid"], af, mf))
                        all_iids.add(e["iid"])
        if not to_splice:
            sys.exit("error: none of the declared overrides compiled to an asset.")

        # 2. resolve target big + the stream, and split overrides into replace (id present) vs insert (new)
        big, stream, stream_iids = find_target_big_and_stream(cfg, target, all_iids, spec.get("stream"))
        # Never bake FROM a corrupt base: a truncated source big would silently yield garbage overrides.
        if not big_is_complete(big):
            backup = big.with_suffix(".big.openwrath-backup")
            hint = (f" Restore it first: openwrath mod revert {target}" if backup.exists()
                    else " No backup found — reinstall the target mod.")
            sys.exit(f"error: the installed {big.name} is truncated/corrupt — refusing to bake from it.{hint}")
        replace = [(t, i, af, mf) for (t, i, af, mf) in to_splice if i in stream_iids]
        insert = [(t, i, af, mf) for (t, i, af, mf) in to_splice if i not in stream_iids]
        summary = f"{len(replace)} replaced" + (f", {len(insert)} new (inserted)" if insert else "")
        print(f"  target: {big.name}  stream: {stream}  ({summary})")

        # 3. extract that stream, then apply each override (chained): splice existing, insert new.
        cur = work / "extract"
        cur.mkdir()
        subprocess.run(["python3", str(LIB / "bigextract.py"), str(big), f"{stream}.", str(cur)],
                       capture_output=True)

        # SCHEMA-DRIFT GUARD (docs/findings/0010) then the chained splice/insert — both factored into
        # shared helpers so the policy + format knowledge live once (reused by `mod build-local`).
        adopt_th = _insert_drift_guard(insert, cur / f"{stream}.manifest", args.adopt_schema)
        cur = _apply_overrides(work, cur, stream, name, replace, insert, adopt_th)

        # 4. repack a new big, verify it is complete, back up the live one, install, re-verify, else roll back.
        newbig = work / "patched.big"
        r = subprocess.run(["python3", str(LIB / "big_replace.py"), str(big), str(newbig),
                            *[f"data\\{stream}.{ext}={cur}/{stream}.{ext}"
                              for ext in ("manifest", "bin", "relo", "imp")]],
                           capture_output=True, text=True)
        if r.returncode != 0 or not newbig.exists():
            sys.exit(f"error: repack failed (exit {r.returncode}):\n{r.stdout}{r.stderr}")
        # A BIG4 is complete iff no entry's data extends past the file. This catches a truncated/short
        # repack BEFORE it can overwrite the installed archive.
        if not big_is_complete(newbig):
            sys.exit(f"error: repacked big is truncated/corrupt — refusing to install.\n{r.stdout}{r.stderr}")

        backup = big.with_suffix(".big.openwrath-backup")
        if not backup.exists():
            shutil.copy2(big, backup)
        # Install, then fsync + re-verify what actually landed on disk; roll back from backup on any problem.
        shutil.copy2(newbig, big)
        with open(big, "rb") as fh:
            os.fsync(fh.fileno())
        if not big_is_complete(big):
            shutil.copy2(backup, big)
            sys.exit("error: installed big failed its integrity check — ROLLED BACK from backup. "
                     "Nothing was changed; please retry.")
        print(f"\n  ✓ baked + verified intact. backup: {backup.name}")
        print(f"  revert anytime: openwrath mod revert {target}")
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


# --- mod package: compile a standalone, zero-EA overlay + its own big + SkuDef -------------
# A *package* is a self-contained mod a player drops into Mods/ and runs with NO OpenWrath
# installed: its own `<Name>.big` (carrying one overlay stream, e.g. static_mod) + `<Name>.skudef`
# (`add-big <Name>.big`). It ships ONLY the user's declared overrides/additions and IMPORTS
# everything else from the base streams by id (the overlay model, docs/04-...). The hard part is
# emitting ONLY the declared assets: a whole-file inheritFrom include drags referenced base siblings
# in as local copies (EA content). We avoid that by giving the compiler a *sliced single-asset*
# inheritFrom base so siblings stay external imports, and we GATE on it — the emitted id set must
# equal the declared id set or we refuse to ship (finding 0015). Big integrity is fsync+verified
# (finding 0007).
_PKG_NS = ('xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" '
           'xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xai="uri:ea.com:eala:asset:instance"')
_PATH_ALIASES = ("data:", "art:", "audio:", "root:")


def _inherit_of(block_lines: list[str]) -> str | None:
    """The inheritFrom= on an asset block's opening tag (which may span lines up to its '>')."""
    head = []
    for ln in block_lines:
        head.append(ln)
        if ">" in ln:
            break
    m = re.search(r'\binheritFrom="([^"]*)"', "\n".join(head))
    return m.group(1) if m else None


def _declared_blocks(src_path: Path) -> list[dict]:
    """Every TOP-LEVEL asset declared in a mod source (outside <Includes>/<Tags>), as verbatim
    text blocks. Reuses `declared_overrides` (which ids) + `_find_toplevel_block` (the exact block),
    so this is the same block-extraction engine as `inspect --source`/`mod add` — not a re-derivation."""
    ids = declared_overrides(src_path)
    lines = Path(src_path).read_text(encoding="utf-8", errors="replace").splitlines()
    out = []
    for cid in ids:
        found = _find_toplevel_block(lines, cid, None)
        if not found:
            continue
        tag, s, e = found
        block = lines[s:e + 1]
        out.append({"tag": tag, "id": cid, "inherit": _inherit_of(block),
                    "lines": block, "src": str(src_path)})
    return out


def _rewrite_rel_paths(block_lines: list[str], base_dir: Path) -> list[str]:
    """Rewrite non-aliased RELATIVE href=/source= paths to absolute, resolved against base_dir (the
    original SDK file's directory). A sliced base block is compiled from a temp dir, so its relative
    xi:include hrefs (e.g. '../../Includes/X.xml', common on GameObjects) would otherwise break.
    DATA:/ART:/AUDIO:/ROOT: aliases and already-absolute paths are left untouched (finding 0015)."""
    def repl(m: re.Match) -> str:
        attr, val = m.group(1), m.group(2)
        low = val.lower()
        if low.startswith(_PATH_ALIASES) or val.startswith("/") or re.match(r"^[A-Za-z]:[\\/]", val):
            return m.group(0)
        try:
            return f'{attr}="{(base_dir / val).resolve()}"'
        except Exception:
            return m.group(0)
    return [re.sub(r'\b(href|source)="([^"]*)"', repl, ln) for ln in block_lines]


def _grep_sdk_block(sdk: str, inst: str, want_type: str | None = None):
    """Find+slice a single asset's top-level block from the SDK source (same resolution as
    `mod add`: grep for id, prefer authoring files over maps). Returns (tag, block_lines, src_file)
    or None."""
    import subprocess
    r = subprocess.run(["grep", "-rlF", f'id="{inst}"', sdk], capture_output=True, text=True)
    files = [f for f in r.stdout.splitlines() if f]
    files.sort(key=lambda f: ("/maps/" in f.lower(), f))
    for fp in files:
        lines = Path(fp).read_text(encoding="utf-8", errors="replace").splitlines()
        found = _find_toplevel_block(lines, inst, want_type)
        if found:
            tag, s, e = found
            return tag, lines[s:e + 1], fp
    return None


def _resolve_include_path(val: str, base_dir: Path, sdk: Path) -> Path | None:
    """Resolve an <Include source> to an on-disk .xml path for define-harvesting. DATA:/ROOT: resolve
    under the SDK data root; a plain relative path against the including file's dir. ART:/AUDIO: (binary
    art/audio) are skipped — they hold no <Define>s and must not be pulled in."""
    low = val.lower()
    if low.startswith(("art:", "audio:")):
        return None
    if low.startswith(("data:", "root:")):
        p = sdk / val.split(":", 1)[1].lstrip("/\\").replace("\\", "/")
    elif re.match(r"^[A-Za-z]:[\\/]", val) or val.startswith("/"):
        p = Path(val)
    else:
        p = base_dir / val
    return p if (p.suffix.lower() == ".xml" and p.exists()) else None


def _collect_defines(src_path: str, sdk: Path, seen: set | None = None) -> list[str]:
    """Every `<Define>` row reachable from a source file — its own `<Defines>` plus, transitively, the
    defines in the files it `<Include>`s (e.g. GlobalDefines.xml). A sliced asset's `=$MACRO` attribute
    values are substituted by the compiler's `ExpressionEvaluator` from the document's defines, so the
    slice must carry them or validation rejects the raw macro name. `=$` macros are pervasive in the SDK,
    so this matters. We *inline the rows* rather than re-include the files, which both carries the whole
    reachable define set and avoids pulling any asset/art sibling local (finding 0015)."""
    seen = seen if seen is not None else set()
    p = os.path.realpath(src_path)
    if p in seen or not os.path.exists(p):
        return []
    seen.add(p)
    out: list[str] = []
    in_defs = False
    for ln in Path(p).read_text(encoding="utf-8", errors="replace").splitlines():
        s = ln.strip()
        if s.startswith("<Defines>"):
            in_defs = True
        elif s.startswith("</Defines>"):
            in_defs = False
        elif in_defs and s.startswith("<Define"):
            out.append("\t\t" + s)
        elif s.startswith("<Include") and "source=" in s:
            m = re.search(r'source="([^"]*)"', s)
            inc = _resolve_include_path(m.group(1), Path(p).parent, sdk) if m else None
            if inc:
                out += _collect_defines(str(inc), sdk, seen)
    return out


def _collect_inherit_bases(cfg: dict, declared: list[dict], work: Path) -> Path | None:
    """Write ONE include file holding the sliced inheritFrom bases (and their inheritFrom ancestors)
    for every declared override whose base is NOT itself declared in the mod. Returns the file path,
    or None if nothing to slice (all declarations are brand-new / self-contained). These are tentative
    base instances for inheritance only — they are not referenced at runtime, so they are NOT emitted
    into the overlay (only the user's declared assets are). Their referenced siblings stay external →
    imports, which is the whole point (finding 0015). The macro context of each source file sliced from
    is carried alongside so `=$MACRO` base values still resolve."""
    (sdk,) = _need(cfg, "sdk")
    sdk_path = Path(sdk)
    declared_ids = {b["id"] for b in declared}
    visited: set = set()
    sliced: list[list[str]] = []
    ctx_files: set = set()
    ctx_defs: list[str] = []
    seen_def: set = set()

    def add_context(fp: str) -> None:
        if fp in ctx_files:
            return
        ctx_files.add(fp)
        for l in _collect_defines(fp, sdk_path):     # inline all reachable <Define> rows, deduped by name
            m = re.search(r'name="([^"]*)"', l)
            nm = m.group(1) if m else l.strip()
            if nm not in seen_def:
                seen_def.add(nm)
                ctx_defs.append(l)
    # Seed from each declared asset's inheritFrom. A SELF-override (`inheritFrom="X"` on asset X) is an
    # override of the BASE asset X, so its base must come from the SDK even though X is also declared.
    # A derivation from a different id is sliced only if that base is NOT itself a mod-declared asset
    # (a mod-local base serves its own children).
    queue = [b["inherit"] for b in declared
             if b["inherit"] and (b["inherit"] == b["id"] or b["inherit"] not in declared_ids)]
    while queue:
        bid = queue.pop()
        if not bid or bid in visited:
            continue
        visited.add(bid)
        got = _grep_sdk_block(sdk, bid)
        if not got:
            vlog(f"  inheritFrom base '{bid}' not found in SDK — leaving the compiler to resolve/error")
            continue
        _tag, block, fp = got
        add_context(fp)
        sliced.append(_rewrite_rel_paths(block, Path(fp).parent))
        anc = _inherit_of(block)   # follow the chain; a mod-local ancestor serves itself (don't slice)
        if anc and anc != bid and anc not in declared_ids and anc not in visited:
            queue.append(anc)
    if not sliced:
        return None
    parts = ['<?xml version="1.0" encoding="utf-8"?>', f"<AssetDeclaration {_PKG_NS}>", "\t<Tags/>"]
    if ctx_defs:
        parts += ["\t<Defines>", *ctx_defs, "\t</Defines>"]
    for b in sliced:
        parts += b + [""]
    parts += ["</AssetDeclaration>", ""]
    out = work / "_bases.xml"
    out.write_text("\n".join(parts), encoding="utf-8")
    return out


def _assemble_package_source(work: Path, stem: str, declared: list[dict],
                             bases: Path | None) -> Path:
    """Build the single packaging source compiled into the overlay: our scoped <Includes> (the sliced
    bases, if any) + every declared asset body verbatim (relative paths rewritten absolute). The
    user's own <Includes> are intentionally dropped and replaced by the scoped ones."""
    incs = (["\t<Includes>", f'\t\t<Include type="instance" source="{bases.name}" />', "\t</Includes>"]
            if bases is not None else [])   # omit an empty <Includes> (all-new mod has no base to slice)
    body: list[str] = []
    for b in declared:
        body += _rewrite_rel_paths(b["lines"], Path(b["src"]).parent) + [""]
    src = work / f"{stem}.xml"
    src.write_text("\n".join([
        '<?xml version="1.0" encoding="utf-8"?>', f"<AssetDeclaration {_PKG_NS}>", "\t<Tags/>",
        *incs, "", *body, "</AssetDeclaration>", ""]), encoding="utf-8")
    return src


def _zero_ea_gate(emitted: set, declared: set) -> tuple[set, set]:
    """The zero-EA packaging invariant as a pure check: returns (extra, missing) where `extra` are
    emitted ids the user never declared (EA/base content that leaked in → must refuse) and `missing`
    are declared ids that failed to compile. A clean package has both empty (finding 0015)."""
    return emitted - declared, declared - emitted


def _win_mods_skudef_line(name: str) -> str:
    """The master-SkuDef `add-config` line that activates this mod. The game resolves it inside its
    own wine view, so the fixed `C:\\users\\steamuser\\Documents\\...` form is correct on every host
    (it mirrors the lines the stock launcher writes for GodMode / SecondIsomer)."""
    return (f"add-config C:\\users\\steamuser\\Documents\\{WINE_DOCS_NAME}"
            f"\\Mods\\{name}\\{name}.skudef")


def _write_pkg_readme(outdir: Path, name: str, cfg: dict, stream: str, ids: list[str]) -> None:
    lines = [
        f"{name} — a Kane's Wrath mod packaged with OpenWrath", "=" * 52, "",
        "Self-contained mod: it contains ONLY this mod's own asset overrides/additions",
        "and imports everything else from your installed base game. It ships zero EA/game",
        f"content and needs no OpenWrath to run. Overlay stream: data\\{stream}.", "",
        f"Assets in this mod ({len(ids)}):", *[f"  - {i}" for i in ids], "",
        "INSTALL", "-------",
        f"1. Copy this '{name}' folder into your Kane's Wrath Mods directory, so you have:",
        f"     Mods/{name}/{name}.big",
        f"     Mods/{name}/{name}.skudef", "",
        "2. Open your master SkuDef (CNC3EP1_<lang>_<version>.SkuDef in the game install",
        "   folder) and add this line next to the other add-config lines:",
        f"     {_win_mods_skudef_line(name)}", "",
        "3. Launch Kane's Wrath. To uninstall: remove that line (and this folder).", "",
        "Built with OpenWrath — a native-Linux, open Kane's Wrath modding toolchain.", ""]
    (outdir / "README.txt").write_text("\n".join(lines), encoding="utf-8")


def _print_registration(cfg: dict, name: str, installed: Path | None) -> None:
    print("\n  To activate (the player needs no OpenWrath — only their own game):")
    step = 1
    if installed is None:
        print(f"    {step}. Copy the '{name}' folder into your Mods directory:")
        md = cfg.get("mods_dir") or "<your Mods dir>"
        print(f"         {md}/{name}/")
        step += 1
    print(f"    {step}. Add this line to your master SkuDef so the launcher loads the mod:")
    print(f"         {_win_mods_skudef_line(name)}")
    if cfg.get("install_skudef"):
        print(f"       (your master SkuDef: {cfg['install_skudef']})")
    step += 1
    print(f"    {step}. Launch Kane's Wrath. Remove the line to deactivate. "
          "(Full steps in README.txt.)")


def cmd_mod_package(args) -> int:
    import tempfile, shutil
    proj = Path(args.project).resolve()
    spec = _read_mod_spec(proj)
    name = spec.get("name", proj.name)
    sources = [proj / s for s in spec.get("sources", [])] or sys.exit("error: mod.toml needs sources")
    stream = args.stream or spec.get("stream") or "static_mod"
    stem = stream[:-4] if stream.endswith("_mod") else stream   # source stem -> <stem>_mod stream

    cfg = read_config()
    _need(cfg, "openwrath", "sdk", "base_manifests", "schema")

    declared: list[dict] = []
    for src in sources:
        if not src.exists():
            sys.exit(f"error: source not found: {src}")
        declared += _declared_blocks(src)
    if not declared:
        sys.exit("error: no top-level asset declarations found in the mod sources.")
    declared_ids = {b["id"] for b in declared}
    print(f"packaging '{name}' — {len(declared)} asset(s) into overlay stream '{stream}'")
    print(f"  assets: {', '.join(sorted(declared_ids))}\n")

    work = Path(tempfile.mkdtemp(prefix="openwrath-pkg-"))
    try:
        # 1. scoped compile: sliced inheritFrom bases (so deps stay imports) + declared bodies
        bases = _collect_inherit_bases(cfg, declared, work)
        pkg_src = _assemble_package_source(work, stem, declared, bases)
        mf, _assets = compile_source(cfg, pkg_src, work / "compile")
        produced = mf.stem                       # e.g. static_mod
        streamdir = mf.parent

        # 2. ZERO-EA GATE (finding 0015): emitted ids MUST equal declared ids
        emitted = {(e["name"] or "").split(":", 1)[-1] for e in parse_manifest(str(mf))}
        extra, missing = _zero_ea_gate(emitted, declared_ids)
        if extra:
            sys.exit(
                "error: ZERO-EA GATE FAILED — the overlay would embed asset(s) you did not declare "
                "(EA/base content):\n       " + ", ".join(sorted(extra)) +
                "\n       An inheritFrom base dragged a referenced sibling in as a local copy. "
                "Refusing to\n       ship EA content. Please report this with the mod sources "
                "(see docs/findings/0015).")
        if missing:
            sys.exit("error: these declared assets did not compile into the overlay:\n       "
                     + ", ".join(sorted(missing)) +
                     f"\n       Run `openwrath mod check {proj.name}` to see why.")

        parts = {}
        for ext in _STREAM_EXTS:
            p = streamdir / f"{produced}.{ext}"
            if not p.exists():
                sys.exit(f"error: compile did not produce {produced}.{ext}")
            parts[ext] = p

        # 3. pack the standalone big (reuse pytools/pack_big), then fsync + integrity-verify (0007)
        outdir = Path(args.out).resolve() if args.out else (proj / "dist" / name)
        outdir.mkdir(parents=True, exist_ok=True)
        bigpath = outdir / f"{name}.big"
        sys.path.insert(0, str(Path(cfg["openwrath"]) / "pytools"))
        import pack_big
        entries = [(f"data\\{stream}.{ext}", parts[ext].read_bytes()) for ext in _STREAM_EXTS]
        # Overlay LOAD HANDSHAKE (finding 0015): the engine discovers a mod overlay via a
        # `data\<family>.version` file whose CONTENT is the stream postfix — e.g. `data\static.version` =
        # "_mod\n" tells it to load `static` + `_mod` = `static_mod` over the base `static_common`.
        # SecondIsomer ships exactly these; without it the engine won't load our overlay. The stream is
        # <family><postfix>; we emit the version file for that split.
        if stream.endswith("_mod"):
            entries.append((f"data\\{stem}.version", b"_mod\n"))   # family=stem, postfix=_mod
        else:
            print(f"  ⚠ stream '{stream}' lacks the '_mod' overlay postfix — the engine's .version "
                  f"handshake expects <family>_mod, so the mod may not load. Prefer a *_mod stream name.")
        pack_big.pack(str(bigpath), entries)
        with open(bigpath, "rb") as fh:
            os.fsync(fh.fileno())
        if not big_is_complete(bigpath):
            sys.exit("error: the packed big failed its integrity check (not a complete BIG4) — "
                     "refusing. Please retry.")

        # 4. the mod's own SkuDef + a README with install/registration steps
        (outdir / f"{name}.skudef").write_text(f"add-big {name}.big\n", encoding="utf-8")
        _write_pkg_readme(outdir, name, cfg, stream, sorted(declared_ids))

        # 5. optional: drop the mod folder straight into Mods/ (owned folder; never touches EA files)
        installed = None
        if args.install:
            (mods,) = _need(cfg, "mods_dir")
            if game_running() and not args.force:
                sys.exit("error: Kane's Wrath appears to be RUNNING — close it before --install "
                         "(or pass --force).")
            dest = Path(mods) / name
            dest.mkdir(parents=True, exist_ok=True)
            shutil.copy2(bigpath, dest / f"{name}.big")
            with open(dest / f"{name}.big", "rb") as fh:
                os.fsync(fh.fileno())
            if not big_is_complete(dest / f"{name}.big"):
                sys.exit("error: the installed big failed its integrity check — refusing.")
            shutil.copy2(outdir / f"{name}.skudef", dest / f"{name}.skudef")
            installed = dest

        print(f"\n  ✓ packaged {len(declared_ids)} asset(s) — zero EA content (gate passed).")
        print(f"  package: {outdir}")
        print(f"    {name}.big      ({bigpath.stat().st_size:,} bytes; stream data\\{stream})")
        print(f"    {name}.skudef   (add-big {name}.big)")
        print(f"    README.txt")
        if installed:
            print(f"  installed to:  {installed}")
        _print_registration(cfg, name, installed)
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


# --- mod build-local: assemble a COMPLETE, loadable static mod from the running patch overlay -----
# Why this exists (finding 0016, corrected): a loadable static `_mod` stream is NOT a from-scratch
# full dataset. The engine loads the static family as a BASE + OVERLAY CHAIN — Core/1.0 `static_common`
# (195 MB, 0% zero-size) is the full byte pool; each patch ships a small OVERLAY carrying a COMPLETE
# ENTRY LIST (every asset's manifest entry, version-current TypeHashes) but INSTANCE DATA only for the
# assets it changed, deferring every unchanged entry to the base by (TypeId, InstanceId). The 1.3 patch's
# `Static_mod` (102texturefix.big) is exactly such an overlay: 21,747 entries, 98% zero-data (only ~384
# art assets carry bytes). A standalone PARTIAL overlay (our zero-EA diff) crashes because its manifest
# ENTRY LIST is incomplete — not because it lacks every asset's DATA.
#
# So the cheapest loadable build is: take a COPY of the patch's own `Static_mod` overlay (which the engine
# already loads today) and splice the user's compiled edits into it (REPLACE over the matching entry, which
# is zero-size until we fill it; the base supplies all the others). The result is byte-for-byte what the
# engine loads now + the user's changes. It rides the patch overlay's EA art bytes, so it is EA-derived →
# LOCAL-ONLY, never shareable (the zero-EA path is `mod package` + assemble-at-install; see finding 0016).
_VERSION_POSTFIX = "_mod"   # the active static overlay postfix (data\<family>.version content), per 0016
# The static base+overlay CHAIN under the `_mod` patch overlay, highest precedence → lowest (finding 0016).
# A mod's static_mod must be COMPLETE, so build-local fills the patch overlay's deferred entries from these.
_STATIC_CHAIN = ("static_common_2", "static_common_1", "static_common")


def _install_overlay_stream(cfg: dict, stream: str):
    """Find, in the READ-ONLY game install, the patch-overlay big that provides the active top `stream`
    (e.g. `static_mod` lives in Patch103/102texturefix.big), and return
    (big_path, {ext -> exact archived path}, version_archived_or_None, version_bytes_or_None).

    This is the complete-entry-list overlay the engine loads today; `build-local` splices into a COPY of
    it so the result = what the engine already loads + the user's edits. Matches archived names
    case-insensitively (the patch ships `data\\Static_mod.*`; SI ships `data\\static_mod.*`) and keeps the
    big's exact casing for repacking. If several bigs provide the stream, picks the one whose manifest is
    largest (the complete top overlay) and says which. BYO/EA big is only READ — never modified in place."""
    import sys as _sys
    (gi,) = _need(cfg, "game_install")
    _sys.path.insert(0, str(LIB))
    import bigextract
    want = {ext: f"{stream}.{ext}".lower() for ext in _STREAM_EXTS}
    family = stream[:-len(_VERSION_POSTFIX)] if stream.endswith(_VERSION_POSTFIX) else stream
    ver_want = f"{family}.version".lower()
    candidates = []   # (manifest_size, big, {ext->archived}, ver_archived, ver_bytes)
    for big in sorted(Path(gi).rglob("*.big")):
        try:
            ents = bigextract.entries(big)
        except Exception:
            continue
        found: dict = {}
        ver_arch = None
        msize = 0
        for nm, foff, fsize in ents:
            base = nm.replace("\\", "/").rsplit("/", 1)[-1].lower()
            for ext, target in want.items():
                if base == target:
                    found[ext] = nm
                    if ext == "manifest":
                        msize = fsize
            if base == ver_want:
                ver_arch = nm
        if all(ext in found for ext in _STREAM_EXTS):
            ver_bytes = None
            if ver_arch is not None:
                import tempfile as _tf
                with _tf.TemporaryDirectory() as td:
                    bigextract.extract(str(big), ver_arch, td)
                    vp = Path(td) / Path(ver_arch.replace("\\", "/")).name
                    ver_bytes = vp.read_bytes() if vp.exists() else None
            candidates.append((msize, big, found, ver_arch, ver_bytes))
    if not candidates:
        sys.exit(f"error: no big in the game install provides a complete '{stream}' stream "
                 f"(data\\{stream}.manifest/bin/relo/imp). Is this the right stream name for a "
                 f"base-game overlay? (static family → 'static_mod').")
    candidates.sort(key=lambda c: c[0], reverse=True)
    if len(candidates) > 1:
        print(f"  note: {len(candidates)} bigs provide '{stream}'; using the largest "
              f"(complete overlay): {candidates[0][1].name}")
    _, big, found, ver_arch, ver_bytes = candidates[0]
    return big, found, ver_arch, ver_bytes


def _autoorder_forward_refs(cur: Path, stream: str) -> None:
    """Finding 0011: a `ProjectileNugget`'s projectile/warhead bind by forward lookup at load — a template
    ordered AFTER the weapon in the compiled stream binds to null and the weapon silently won't launch/detonate.
    After the overrides are applied, detect every FATAL forward edge and reorder the stream so each target
    precedes its referrer (projectile mods then 'just work' without manual surgery), re-checksum, and GATE the
    build on a clean result. No-op when there are none (the common case) — the stream is left untouched."""
    import subprocess
    pfx = str(cur / stream)
    fix = subprocess.run(["python3", str(LIB / "reorder_stream.py"), pfx, pfx, "--auto-fix"],
                         capture_output=True, text=True)
    out = (fix.stdout + fix.stderr).strip()
    if "no FATAL forward references" in out:
        return                                  # nothing to do; assemble-time checksum still valid
    print("  forward-ref auto-order (finding 0011):")
    print("    " + out.replace("\n", "\n    "))
    # reordering changed entry order -> the stream identity (checksum over the ordered tuples) must be recomputed.
    subprocess.run(["python3", str(LIB / "retag_checksum.py"), pfx], capture_output=True, text=True)
    gate = subprocess.run(["python3", str(LIB / "check_forward_refs.py"), pfx + ".manifest"],
                          capture_output=True, text=True)
    if gate.returncode != 0:
        sys.exit("error: forward-reference auto-order did not clear all FATAL edges:\n" + gate.stdout + gate.stderr)
    print("    ✓ 0 fatal forward references remain")


def cmd_mod_build_local(args) -> int:
    """Assemble a COMPLETE, loadable static mod locally from the running patch's overlay + the user's
    edits. EA-derived (rides the patch overlay's bytes) → local-only, never shareable."""
    import tempfile, shutil
    proj = Path(args.project).resolve()
    spec = _read_mod_spec(proj)
    name = spec.get("name", proj.name)
    sources = [proj / s for s in spec.get("sources", [])] or sys.exit("error: mod.toml needs sources")
    stream = args.stream or spec.get("stream") or "static_mod"
    if stream != "static_mod":
        # splice_asset / insert_asset operate on static_mod.*-named files; other families need the
        # same normalization wired for their stem. Scoped to static for now (the 0016 subject).
        sys.exit(f"error: build-local currently supports the 'static_mod' stream only (got '{stream}').")

    cfg = read_config()
    _need(cfg, "openwrath", "sdk", "base_manifests", "schema", "game_install")
    if args.install:
        _need(cfg, "mods_dir")
        if game_running() and not args.force:
            sys.exit("error: Kane's Wrath appears to be RUNNING — close it before --install "
                     "(or pass --force).")

    # Pre-flight validation (same gate as bake), unless skipped.
    if not getattr(args, "no_check", False):
        print("pre-flight check:")
        if run_mod_check(cfg, proj, quiet=False):
            sys.exit("error: pre-flight check found problems (above) — fix them or re-run with "
                     "--no-check to build anyway.")
        print()
    print(f"building LOCAL complete '{name}' — assembling the full '{stream}' from your base chain + your edits\n")

    work = Path(tempfile.mkdtemp(prefix="openwrath-local-"))
    try:
        # 1. compile each source; collect the override assets it declares (same as bake).
        to_splice = []  # (tid, iid, asset_file, manifest)
        all_iids = set()
        for src in sources:
            want = set(declared_overrides(src))
            print(f"  compiling {src.name} ({len(want)} overrides: {', '.join(sorted(want))})")
            mf, assets = compile_source(cfg, src, work / src.stem)
            for e in parse_manifest(str(mf)):
                inst = (e["name"] or "").split(":", 1)[-1]
                if inst in want:
                    af = assets / f'{e["tid"]:08x}.{e["th"]:08x}.{e["iid"]:08x}.{e["ih"]:08x}.asset'
                    if af.exists():
                        to_splice.append((e["tid"], e["iid"], af, mf))
                        all_iids.add(e["iid"])
        if not to_splice:
            sys.exit("error: none of the declared overrides compiled to an asset.")

        # 2. assemble a COMPLETE base stream from the running patch overlay + the base chain (finding 0016).
        #    A mod's static_mod must be COMPLETE (every asset real-data) so each asset's imports resolve to a
        #    real, local target — a sparse overlay (our first cut) crashed because the warhead a weapon imports
        #    was a zero-size deferred stub. We fill the patch overlay's deferred entries with real data from the
        #    chain (sc2 > sc1 > sc0 = Core/1.0 static_common). All bigs below are READ-only EA.
        import sys as _sys, subprocess
        _sys.path.insert(0, str(LIB)); import bigextract
        chain = work / "chain"; chain.mkdir()

        def _extract_stream(src_big, arch_map, prefix):
            for ext in _STREAM_EXTS:
                bigextract.extract(str(src_big), arch_map[ext], str(chain))
                got = chain / Path(arch_map[ext].replace("\\", "/")).name
                norm = chain / f"{prefix}.{ext}"
                if got.resolve() != norm.resolve():
                    got.rename(norm)

        big, archived, ver_arch, ver_bytes = _install_overlay_stream(cfg, stream)
        print(f"  patch overlay: {big.name}")
        _extract_stream(big, archived, stream)                       # -> chain/static_mod.*
        chain_prefixes = []
        for cs in _STATIC_CHAIN:
            cbig, carch, _, _ = _install_overlay_stream(cfg, cs)
            print(f"  chain: {cbig.name} ({cs})")
            _extract_stream(cbig, carch, cs)                         # -> chain/static_common*.*
            chain_prefixes.append(str(chain / cs))
        comp = work / "complete"
        print("  assembling complete stream (filling deferred entries from the base chain)…")
        r = subprocess.run(["python3", str(LIB / "assemble_complete_stream.py"), str(comp),
                            str(chain / stream), *chain_prefixes], capture_output=True, text=True)
        if not (comp / f"{stream}.manifest").exists():
            sys.exit(f"error: complete-stream assembly failed:\n{r.stdout}{r.stderr}")
        print("    " + (r.stdout.strip().replace("\n", "\n    ")))

        # 3. split REPLACE (id already in the complete stream — the common case) vs INSERT (new), + 0010 guard.
        stream_iids = {e["iid"] for e in parse_manifest(str(comp / f"{stream}.manifest"))}
        replace = [(t, i, af, mf) for (t, i, af, mf) in to_splice if i in stream_iids]
        insert = [(t, i, af, mf) for (t, i, af, mf) in to_splice if i not in stream_iids]
        print(f"  {len(replace)} replaced, {len(insert)} new (inserted)")
        adopt_th = _insert_drift_guard(insert, comp / f"{stream}.manifest", args.adopt_schema)

        # 4. apply the overrides into the complete stream (shared engine with bake).
        cur = _apply_overrides(work, comp, stream, name, replace, insert, adopt_th)

        # 4b. finding 0011: auto-order so a ProjectileNugget's projectile/warhead precede the weapon (else the
        #     forward reference binds to null at load and the weapon silently won't launch). Re-checksums + gates.
        _autoorder_forward_refs(cur, stream)

        # 5. pack the standalone LOCAL mod big with LOWERCASE archived names + `data\<family>.version`.
        #    IN-GAME FINDING (0016, control test 2026-11-24): a mod big that shadows the patch overlay with the
        #    patch's CAPITAL names (`data\Static_mod.*`, `data\Static.version`) CRASHED at launch; the same stream
        #    packed LOWERCASE (`data\static_mod.*`, `data\static.version`) — exactly how SecondIsomer, the one
        #    proven-working mod, ships it — LOADS and defers unchanged assets to the base. So we always emit the
        #    lowercase mod form, never the patch's casing. fsync + integrity-verify (0007).
        family = stream[:-len(_VERSION_POSTFIX)] if stream.endswith(_VERSION_POSTFIX) else stream
        outdir = Path(args.out).resolve() if args.out else (proj / "dist-local" / name)
        outdir.mkdir(parents=True, exist_ok=True)
        bigpath = outdir / f"{name}.big"
        _sys.path.insert(0, str(Path(cfg["openwrath"]) / "pytools")); import pack_big
        entries = [(f"data\\{stream}.{ext}", (cur / f"{stream}.{ext}").read_bytes()) for ext in _STREAM_EXTS]
        if ver_bytes is not None:
            entries.append((f"data\\{family}.version", ver_bytes))   # data\static.version = b"_mod\n"
        pack_big.pack(str(bigpath), entries)
        with open(bigpath, "rb") as fh:
            os.fsync(fh.fileno())
        if not big_is_complete(bigpath):
            sys.exit("error: the packed big failed its integrity check (not a complete BIG4) — refusing.")

        # 6. the mod's own SkuDef + a LOCAL-ONLY readme (loud about EA-derived / do-not-share).
        (outdir / f"{name}.skudef").write_text(f"add-big {name}.big\n", encoding="utf-8")
        _write_local_readme(outdir, name, cfg, stream, big.name)

        # 7. optional: install into Mods/ (owned folder; never touches EA files).
        installed = None
        if args.install:
            (mods,) = _need(cfg, "mods_dir")
            dest = Path(mods) / name
            dest.mkdir(parents=True, exist_ok=True)
            shutil.copy2(bigpath, dest / f"{name}.big")
            with open(dest / f"{name}.big", "rb") as fh:
                os.fsync(fh.fileno())
            if not big_is_complete(dest / f"{name}.big"):
                sys.exit("error: the installed big failed its integrity check — refusing.")
            shutil.copy2(outdir / f"{name}.skudef", dest / f"{name}.skudef")
            installed = dest

        print(f"\n  ✓ built LOCAL complete mod — {len(replace)} replaced, {len(insert)} inserted.")
        print(f"  ⚠ LOCAL-ONLY: this big carries EA-derived base/patch bytes — do NOT share it. "
              f"(Shareable path: `openwrath mod package` + assemble-at-install; finding 0016.)")
        print(f"  package: {outdir}")
        print(f"    {name}.big      ({bigpath.stat().st_size:,} bytes; stream data\\{stream})")
        print(f"    {name}.skudef   (add-big {name}.big)")
        print(f"    README.txt")
        if installed:
            print(f"  installed to:  {installed}")
        _print_registration(cfg, name, installed)
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


