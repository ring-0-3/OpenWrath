    XDG default that `gen-stringhashes` writes if it exists, else None (omit). No personal path."""
    sh = cfg.get("stringhashes")
    if sh and Path(sh).exists():
        return sh
    fallback = _xdg_data_dir() / "StringHashes.xml"
    return str(fallback) if fallback.exists() else None


def _toplevel_indent(lines: list[str]) -> str:
    """The leading-whitespace prefix of a direct child of <AssetDeclaration>, detected from the first
    indented element line (the SDK uses a tab; hand-authored sources may use spaces). This keeps the
    top-level block extractor indentation-agnostic without widening it to match nested elements."""
    for ln in lines:
        m = re.match(r"^([ \t]+)<[A-Za-z]", ln)
        if m:
            return m.group(1)
    return "\t"


def _find_toplevel_block(lines: list[str], inst: str, want_type: str | None):
    """Find the enclosing TOP-LEVEL asset element (a direct child of <AssetDeclaration>, at the
    document's one-level indent) whose id attribute == inst (optionally of tag == want_type).
    Returns (tag, start_line, end_line) inclusive, or None. Line-based so original formatting
    and comments are preserved verbatim; this also rejects nested references (e.g. a map that
    merely places the object at deeper indentation). The indent is detected per-file so tab- and
    space-indented sources both work."""
    indent = _toplevel_indent(lines)
    open_re = re.compile(r"^%s<([A-Za-z_][\w.]*)" % re.escape(indent))
    n = len(lines)
    i = 0
    while i < n:
        m = open_re.match(lines[i])
        if not m:
            i += 1
            continue
        tag = m.group(1)
        # Accumulate the opening tag region until it is closed by '>'.
        j = i
        closed = self_closing = False
        otext = []
        while j < n:
            otext.append(lines[j])
            if ">" in lines[j]:
                self_closing = lines[j].rstrip().endswith("/>")
                closed = True
                break
            j += 1
        if not closed:
            i += 1
            continue
        idm = re.search(r'\bid="([^"]*)"', "\n".join(otext))
        this_id = idm.group(1) if idm else None
        # An element can also close on the SAME line it opens — either self-closing (`.../>`) or with an
        # inline end tag (`<Tag ...></Tag>`, e.g. a bare ArmorTemplate). Without this, an inline-closed
        # element's "block" would run forward to the next *multiline* close, swallowing every inline-closed
        # sibling in between (so they'd never be found).
        if self_closing or f"</{tag}>" in lines[j]:
            end = j
        else:
            close_re = re.compile(r"^%s</%s>\s*$" % (re.escape(indent), re.escape(tag)))
            k = j + 1
            while k < n and not close_re.match(lines[k]):
                k += 1
            end = k if k < n else j
        if this_id == inst and (not want_type or tag.lower() == want_type.lower()):
            return tag, i, end
        i = end + 1
    return None


def cmd_inspect_source(args) -> int:
    """Print the AUTHORING XML for an asset from the SDK source tree (cleaner than the
    verbose decompiled form)."""
    import subprocess
    cfg = read_config()
    (sdk,) = _need(cfg, "sdk")
    inst = args.asset
    want_type = args.type
    r = subprocess.run(["grep", "-rlF", f'id="{inst}"', sdk],
                       capture_output=True, text=True)
    files = [f for f in r.stdout.splitlines() if f]
    if not files:
        sys.exit(f"error: no SDK source under {sdk} declares id=\"{inst}\".")
    # Prefer non-map authoring files; maps only reference/override instances.
    files.sort(key=lambda f: ("/maps/" in f.lower(), f))
    vlog(f"candidate source file(s): {len(files)}")
    for fp in files:
        lines = Path(fp).read_text(encoding="utf-8", errors="replace").splitlines()
        found = _find_toplevel_block(lines, inst, want_type)
        if found:
            tag, start, end = found
            vlog(f"matched {tag} id=\"{inst}\" at {fp}:{start+1}-{end+1}")
            print(f"# {fp}  ({tag} id=\"{inst}\", lines {start+1}-{end+1})")
            sys.stdout.write("\n".join(lines[start:end + 1]) + "\n")
            return 0
    hint = f" of type '{want_type}'" if want_type else ""
    sys.exit(f"error: found id=\"{inst}\" in the SDK but no enclosing top-level asset "
             f"element{hint} (it may only appear as a nested reference). "
             f"Searched: {files[0]}")


def cmd_inspect(args) -> int:
    import tempfile, glob, shutil, time
    if args.source:
        return cmd_inspect_source(args)
    cfg = read_config()
    bm, schema, ow = _need(cfg, "base_manifests", "schema", "openwrath")
    idx = load_stream_index(cfg, args.target, args.stream)
    hits = _resolve_asset(idx, args.asset, args.type)
    if len({e["name"] for e in hits}) > 1:
        sys.exit("error: ambiguous — multiple assets named '%s': %s. "
                 "Disambiguate with --type <Type>."
                 % (args.asset, ", ".join(sorted(e["name"] for e in hits))))
    inst = hits[0]["inst"]
    big, stream = idx["big"], idx["stream"]
    cdir, _hit = ensure_stream_cache(big, stream, idx["target"], args.no_cache)
    man = cdir / f"{stream}.manifest"
    if not man.exists() or man.stat().st_size == 0:
        sys.exit(f"error: could not extract stream '{stream}' from {big.name}.")
    dec = Path(tempfile.mkdtemp(prefix="openwrath-inspect-"))
    try:
        rm = f'{Path(bm) / "global_common_2.manifest"};{Path(bm) / "static_common_2.manifest"}'
        cmd = ["dotnet", str(Path(ow) / "Debug/bab-decompile.dll"), "decompile-stream",
               str(man), "--rm", rm, "--schema", schema, "--only", inst, "--outdir", str(dec)]
        sh = _default_stringhashes(cfg)
        if sh:
            cmd += ["--stringhashes", sh]
        t0 = time.time()
        r = _run(cmd, capture_output=True, text=True)
        vlog(f"decompile-stream --only {inst}  ({time.time()-t0:.2f}s)")
        xmls = glob.glob(str(dec / "*.xml"))
        if not xmls:
            sys.exit(f"error: decompile produced no XML for '{inst}'.\n"
                     f"{r.stdout[-800:]}{r.stderr[-400:]}")
        # decompile-stream names each file "<Type>.<Instance>.xml"; a --only name can match
        # several types, so pick the one for the resolved asset's type.
        typ = hits[0]["type"]
        want_name = f"{typ}.{inst}.xml".lower() if typ else None
        pick = (next((x for x in xmls if Path(x).name.lower() == want_name), None)
                or next((x for x in xmls if inst.lower() in Path(x).name.lower()), xmls[0]))
        sys.stdout.write(Path(pick).read_text(encoding="utf-8", errors="replace"))
        return 0
    finally:
        shutil.rmtree(dec, ignore_errors=True)
        if args.no_cache:
            shutil.rmtree(cdir, ignore_errors=True)


def cmd_verify(args) -> int:
    """Byte-exact check of an asset against the GAME'S OWN shipped bytes.

    Finds the base-game .big holding <stream>.manifest, extracts the stream (cached), RefPack-
    decompresses it, and runs the proven roundtrip harness (--from-binary) to confirm OpenWrath
    reproduces the shipped bytes. Bundles NO game content — reads only the user's install."""
    import subprocess, tempfile, shutil, time
    cfg = read_config()
    ow, sdk, bm, schema, gi = _need(cfg, "openwrath", "sdk", "base_manifests",
                                    "schema", "game_install")
    stream = args.stream or "static_common"

    # 1. locate the base-game big that holds <stream>.manifest
    sys.path.insert(0, str(LIB))
    import bigextract, refpack
    want = f"{stream}.manifest".lower()
    big = None
    for cand in sorted(Path(gi).rglob("*.big")):
        try:
            if any(want in nm.lower() for nm, _, _ in bigextract.entries(str(cand))):
                big = cand
                break
        except Exception:
            continue
    if big is None:
        sys.exit(f"error: no .big under {gi} contains a '{stream}.manifest' stream.")
    vlog(f"base stream '{stream}' lives in: {big}")

    # 2. extract (cached) then RefPack-decompress the 4 stream files
    cdir, _hit = ensure_stream_cache(big, stream, big.stem, args.no_cache)
    work = Path(tempfile.mkdtemp(prefix="openwrath-verify-"))
    try:
        for ext in _STREAM_EXTS:
            src = cdir / f"{stream}.{ext}"
            if not src.exists():
                continue
            data = src.read_bytes()
            if refpack.is_refpack(data):
                out, _ = refpack.decompress(data)
                vlog(f"  refpack {ext}: {len(data)} -> {len(out)} bytes")
            else:
                out = data
                vlog(f"  {ext}: {len(data)} bytes (not refpack, kept)")
            (work / f"{stream}.{ext}").write_bytes(out)
        man = work / f"{stream}.manifest"
        if not man.exists():
            sys.exit(f"error: no decompressed {stream}.manifest to verify against.")

        # 3. run the byte-exact harness against the game's own bytes
        rt = Path(ow) / "tools/roundtrip.sh"
        if not rt.exists():
            sys.exit(f"error: roundtrip harness not found at {rt}.")
        env = _dotnet_env()
        env.update(KW_DATAROOT=sdk, KW_BASEMANIFESTS=bm, KW_SCHEMA=schema)
        sh = _default_stringhashes(cfg)
        if sh:
            env["KW_STRINGHASHES"] = sh
        cmd = ["bash", str(rt), "--from-binary", str(man), "--only", args.asset]
        if sh:
            cmd += ["--stringhashes", sh]
        vlog(f"roundtrip: {' '.join(cmd)}")
        t0 = time.time()
        r = subprocess.run(cmd, env=env, capture_output=True, text=True)
        vlog(f"roundtrip exit={r.returncode}  ({time.time()-t0:.2f}s)")

        # 4. parse + echo the per-asset result for this asset
        buckets = ("BYTEEXACT", "SIZEOK_VALDIFF", "SIZEDIFF", "RECOMPILE-MISSING")
        result_lines = [ln for ln in r.stdout.splitlines()
                        if ln.strip().split()[:1] and ln.strip().split()[0] in buckets]
        if args.type:
            wt = args.type.lower()
            typed = [ln for ln in result_lines
                     if f"{wt}:" in ln.lower() or f" {wt}:" in ln.lower()]
            if typed:
                result_lines = typed
        if not result_lines:
            sys.stderr.write(r.stdout[-1200:] + r.stderr[-600:])
            sys.exit(f"error: verify produced no per-asset result for '{args.asset}' "
                     f"(stream '{stream}', big {big.name}).")
        for ln in result_lines:
            print(ln.strip())
        verdict = result_lines[0].strip().split()[0]
        if len(result_lines) == 1 and verdict == "BYTEEXACT":
            print(f"\n{args.asset}: BYTEEXACT — OpenWrath reproduces the game's shipped bytes.")
            return 0
        allexact = all(ln.strip().split()[0] == "BYTEEXACT" for ln in result_lines)
        if allexact:
            print(f"\n{args.asset}: BYTEEXACT ({len(result_lines)} assets).")
            return 0
        print(f"\n{args.asset}: NOT byte-exact — see result(s) above.")
        return 1
    finally:
        shutil.rmtree(work, ignore_errors=True)
        if args.no_cache:
            shutil.rmtree(cdir, ignore_errors=True)


def cmd_schema(args) -> int:
    """Show a stream's per-type SCHEMA fingerprints, and where they DRIFT from our compiler.

    Every asset entry carries a TypeHash — a fingerprint of that type's schema. The engine requires one
    fingerprint per type across a stream, so a mod stream built against a different schema version than
    retail (what our byte-exact compiler targets) carries a different hash for that type. INSERTing a new
    asset of a drifted type crashes the game on load (docs/findings/0010); REPLACE is immune (it keeps the
    stream's existing hash). This command makes that visible: for each type in the stream it prints the
    stream's hash, our compiler's native hash, and a status — so you can SEE the schema before adapting."""
    from collections import defaultdict
    cfg = read_config()
    idx = load_stream_index(cfg, args.target, args.stream)
    ours = our_type_hashes(cfg)

    groups = defaultdict(lambda: {"tid": None, "hashes": set(), "count": 0})
    for e in idx["entries"]:
        typ = e["type"] or f"0x{e['tid']:08x}"
        g = groups[typ]
        g["tid"] = e["tid"]
        g["hashes"].add(e["th"])
        g["count"] += 1

    want = (args.type or "").lower()
    rows = []
    for typ in sorted(groups):
        if want and want not in typ.lower():
            continue
        g = groups[typ]
        sh = sorted(g["hashes"])
        our_h = ours.get(typ)
        if len(sh) > 1:
            status = "MIXED"              # stream itself carries >1 hash for this type (unexpected)
        elif our_h is None:
            status = "unregistered"       # our compiler has no native hash for this type
        elif our_h == sh[0]:
            status = "match"
        else:
            status = "DRIFT"
        if args.drift_only and status not in ("DRIFT", "MIXED"):
            continue
        rows.append((typ, g["tid"], sh, our_h, status, g["count"]))

    if not rows:
        print("(no matching types)" if (want or args.drift_only) else "(stream is empty)")
        return 0

    # table
    tw = max(len(r[0]) for r in rows)
    print(f"stream '{idx['stream']}' of {idx['target']}  —  {len(rows)} type(s)"
          + (" with drift" if args.drift_only else "") + "\n")
    print(f"  {'TYPE'.ljust(tw)}  {'TYPEID':10}  {'STREAM HASH':12}  {'OUR HASH':12}  STATUS   COUNT")
    print(f"  {'-'*tw}  {'-'*10}  {'-'*12}  {'-'*12}  -------  -----")
    drift_n = 0
    for typ, tid, sh, our_h, status, count in rows:
        if status in ("DRIFT", "MIXED"):
            drift_n += 1
        shs = "/".join(f"0x{h:08x}" for h in sh)
        ohs = f"0x{our_h:08x}" if our_h is not None else "—"
        print(f"  {typ.ljust(tw)}  0x{tid:08x}  {shs:12}  {ohs:12}  {status:7}  {count}")

    if not args.drift_only and drift_n:
        print(f"\n  {drift_n} type(s) DRIFT from our compiler. Inserting a NEW asset of a drifted type will"
              f"\n  crash on load unless the insert adopts the stream's hash. REPLACE is always safe."
              f"\n  See docs/findings/0010-insert-must-match-target-stream-type-schema-hash.md")
    return 0


# --- gen-stringhashes: build the master StringHashes table from your own SDK -------------
# The binary stores some id / module-tag strings only as one-way hashes. The compiler can emit the
# text<->hash map for a source via -scd:<dir> (it writes <dir>/StringHashes.xml), but one compile
# only covers the strings in that source — so a MASTER table is the union across many sources. This
# mirrors tools/roundtrip.sh (the -scd step) + tools/merge-stringhashes.py (the union), as one step.
_SH_NS = "uri:ea.com:eala:asset"
BASE_STREAMS = ("global_common_2", "static_common_2", "global_english_2")


def _base_rm(bm: Path) -> str:
    """The -rm reference-manifest list for the base streams, from a base_manifests dir (only
    the files that actually exist). Matches SETUP.md / roundtrip.sh."""
    return ";".join(str(bm / f"{s}.manifest") for s in BASE_STREAMS
                    if (bm / f"{s}.manifest").exists())


def _merge_stringhashes(paths) -> dict:
    """Union many per-file StringHashes.xml tables into {hash(int): text(str)}. Visited in sorted
    path order; the FIRST text seen for a hash wins (deterministic). A later, different text for the
    same hash is a genuine collision in the source data — logged to stderr, original kept."""
    import xml.etree.ElementTree as ET
    merged: dict = {}
    for t in sorted(set(str(p) for p in paths)):
        try:
            tree = ET.parse(t)
        except (ET.ParseError, OSError) as e:
            vlog(f"  skip unparseable StringHashes table {t}: {e}")
            continue
        for el in tree.iter():
            if el.tag.split("}")[-1] != "StringAndHash":
                continue
            h, txt = el.get("Hash"), el.get("Text")
            if h is None or txt is None:
                continue
            try:
                hi = int(h)
            except ValueError:
                continue
            if hi in merged:
                if merged[hi] != txt:
                    vlog(f"  collision hash={hi}: keep '{merged[hi]}' drop '{txt}' (from {t})")
            else:
                merged[hi] = txt
    return merged


def _collect_stringhashes(cache_root) -> dict:
    """Merge every StringHashes.xml found under cache_root into one table (recursive)."""
    return _merge_stringhashes(Path(cache_root).rglob("StringHashes.xml"))


def _write_stringhashes(out: Path, merged: dict) -> None:
    """Write the VERSION5 single-TheStringTable form, sorted by numeric hash (stable diff)."""
    out.parent.mkdir(parents=True, exist_ok=True)
    def esc(s: str) -> str:
        return (s.replace("&", "&amp;").replace('"', "&quot;")
                .replace("<", "&lt;").replace(">", "&gt;"))
    lines = ['<?xml version="1.0" encoding="utf-8"?>',
             f'<AssetDeclaration xmlns="{_SH_NS}">',
             '  <StringHashTable id="TheStringTable">']
    lines += [f'    <StringAndHash Hash="{hi}" Text="{esc(merged[hi])}" />'
              for hi in sorted(merged)]
    lines += ['  </StringHashTable>', '</AssetDeclaration>', '']
    out.write_text("\n".join(lines), encoding="utf-8")


def cmd_gen_stringhashes(args) -> int:
    import tempfile, shutil
    cfg = read_config()
    sdk, schema = cfg.get("sdk"), cfg.get("schema")
    missing = [k for k, v in (("sdk", sdk), ("schema", schema))
               if not v or not Path(v).exists()]
    if missing:
        sys.exit(f"error: {', '.join(missing)} not configured (or missing on disk) — run "
                 f"`openwrath init` first (sdk + schema are bring-your-own).")
    ow = cfg.get("openwrath") or str(openwrath_dir())
    bab = Path(ow) / "Debug/BinaryAssetBuilder.dll"
    if not bab.exists():
        sys.exit(f"error: compiler not built — {bab} missing. Build Debug/ first (see SETUP.md).")

    src_root = Path(args.source) if args.source else Path(sdk)
    if not src_root.exists():
        sys.exit(f"error: source path does not exist: {src_root}")
    sources = [src_root] if src_root.is_file() else sorted(src_root.rglob("*.xml"))
    if not sources:
        sys.exit(f"error: no .xml source files under {src_root}")

    out = Path(args.out).expanduser() if args.out else _xdg_data_dir() / "StringHashes.xml"
    bm = Path(cfg["base_manifests"]) if cfg.get("base_manifests") else None
    rm = _base_rm(bm) if (bm and bm.exists()) else ""
    if not rm:
        vlog("  no base_manifests configured — compiling without -rm (ids still hash, cross-refs may not resolve)")

    print(f"gen-stringhashes: compiling {len(sources)} source file(s) under {src_root}\n"
          f"  (per-file failures are tolerated; the table is the union of what compiles)")
    work = Path(tempfile.mkdtemp(prefix="openwrath-stringhashes-"))
    try:
        caches = work / "caches"
        caches.mkdir()
        tables = 0
        for i, src in enumerate(sources):
            cdir = caches / f"c{i}"
            # Mirror tools/roundtrip.sh's reference compile, plus -scd to emit the hash table.
            cmd = ["dotnet", str(bab), str(src), f"-dr:{sdk}", f"-data:{sdk}",
                   f"-od:{work / ('od%d' % i)}", f"-sp:{schema}",
                   "-sc:false", "-bc:false", f"-scd:{cdir}"]
            if rm:
                cmd.append(f"-rm:{rm}")
            _run(cmd, capture_output=True, text=True)
            sh = cdir / "StringHashes.xml"
            if sh.exists() and sh.stat().st_size > 0:
                tables += 1
            vlog(f"  [{i + 1}/{len(sources)}] {src.name}: "
                 f"{'table' if sh.exists() else 'no table'}")
        merged = _collect_stringhashes(caches)
        if not merged:
            sys.exit("error: no StringHashes entries were produced (did any source compile? "
                     "re-run with -v to see per-file results).")
        _write_stringhashes(out, merged)
    finally:
        shutil.rmtree(work, ignore_errors=True)

    cfg["stringhashes"] = str(out)
    write_config(cfg)
    print(f"\n  ✓ {len(merged)} unique hashes from {tables} table(s) -> {out}")
    print(f"  config updated: stringhashes = {out}")
    return 0


# --- extract-manifests: pull the base-stream manifests out of the installed game ---------
def cmd_extract_manifests(args) -> int:
    """Extract + RefPack-decompress the base-stream .manifest files from the installed game's .big
    archives, into a base_manifests dir. These resolve cross-stream references when compiling; they
    are the user's own game data and are written OUTSIDE any repo (XDG), never shipped."""
    cfg = read_config()
    gi = cfg.get("game_install")
    if not gi or not Path(gi).exists():
        sys.exit("error: game install not detected (or missing on disk) — run `openwrath init` "
                 "(or `openwrath detect`) first.")
    out = Path(args.out).expanduser() if args.out else _xdg_data_dir() / "base-manifests"
    out.mkdir(parents=True, exist_ok=True)

    sys.path.insert(0, str(LIB))
    import bigextract, refpack

    bigs = sorted(Path(gi).rglob("*.big"))
    if not bigs:
        sys.exit(f"error: no .big archives under {gi} — is the install complete?")
    done = []
    for stream in BASE_STREAMS:
        member = f"{stream}.manifest"
        hit = None
        for big in bigs:
            try:
                ents = bigextract.entries(str(big))
            except Exception:
                continue
            for nm, foff, fsize in ents:
                if os.path.basename(nm.replace("\\", "/")).lower() == member:
                    hit = (big, foff, fsize)
                    break
            if hit:
                break
        if not hit:
            print(f"  (skipped {stream}: no '{member}' in any .big under the install)")
            continue
        big, foff, fsize = hit
        with open(big, "rb") as f:
            f.seek(foff)
            data = f.read(fsize)
        if refpack.is_refpack(data):                    # RefPack-compressed in the big (0xFB signature)
            data, _ = refpack.decompress(data)
        (out / member).write_bytes(data)
        done.append(stream)
        print(f"  extracted {member} ({len(data)} bytes) <- {big.name}")

    if not done:
        sys.exit(f"error: found no base-stream manifests under {gi} "
                 f"(looked for {', '.join(s + '.manifest' for s in BASE_STREAMS)}).")
    cfg["base_manifests"] = str(out)
    write_config(cfg)
    print(f"\n  ✓ {len(done)} manifest(s) -> {out}")
    print(f"  config updated: base_manifests = {out}")
    return 0


