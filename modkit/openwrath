# --- mod check: pre-flight validation (dangling refs / unknown fields / schema drift) -----
# Benign startup/no-op notices to ignore. "Treating it as empty" covers the art/W3X file-not-found
# notices (ART assets live in art streams not loaded for a gameplay compile; they resolve at runtime),
# which the compiler itself continues past.
_BENIGN_DIAG = ("XIncludingReader", "ExpressionEvaluator", "AudioCompiler", "linux-port",
                "Base patch manifest", "Cached session data", "Treating it as empty")


def _loaded_reference_types(cfg: dict) -> set:
    """Type names actually present in the reference manifests the check loads (`-rm`: global_common_2 +
    static_common_2) — i.e. the types whose owning streams ARE in the check's reference scope. Empty if
    the manifests can't be read (→ everything degrades to an unverifiable warning, never a false abort)."""
    bm = Path(cfg.get("base_manifests") or "")
    types: set = set()
    for s in BASE_STREAMS:
        p = bm / f"{s}.manifest"
        if p.exists():
            for e in parse_manifest(str(p)):
                nm = e.get("name")
                if nm and ":" in nm:
                    types.add(nm.split(":", 1)[0])
    return types


def _ref_severity(ref_type: str, verifiable_types: set) -> str:
    """Severity for an unresolved reference, scope-driven (finding 0015 / reviewer note). ERROR requires
    BOTH halves of the honest condition, pre-combined by the caller into `verifiable_types`: the type is
    (a) MODELED by OpenWrath AND (b) present in the loaded reference scope — only then is a missing
    instance a genuine dangling reference. Otherwise (unmodeled, OR modeled-but-its-stream-not-loaded) the
    ref is unverifiable → 'warn', never a false abort. Pure, so the contract is unit-tested without the
    compiler. NOTE the self-heal needs BOTH: modeling an art type is necessary but **not sufficient** —
    its art stream must also enter the reference scope, or a modeled-but-unloaded art ref would flip to a
    false positive (see the promotion checklist in finding 0015)."""
    return "error" if ref_type in verifiable_types else "warn"


def _find_id_line(src: Path, inst: str) -> int:
    """1-based line of id="inst" in src (best-effort; 0 if absent)."""
    try:
        for i, ln in enumerate(src.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
            if f'id="{inst}"' in ln:
                return i
    except OSError:
        pass
    return 0


def _check_sources(cfg: dict, sources: list[Path], work: Path) -> list[tuple]:
    """Validate each source by compiling it and parsing diagnostics. Returns a list of
    (severity, file, line, message). Reuses `_compile_cmd` so validation sees exactly what a bake
    compiles. Dangling references surface as the compiler's 'Unknown asset ... referenced from ...'
    warnings; schema/unknown-field problems surface as Critical/Error lines (benign startup
    notices filtered).

    The dangling-ref severity is **scope-driven, not category-driven**. An unknown ref is an ERROR only
    when its target type is *verifiable here* = MODELED by OpenWrath (`our_type_hashes`) **and** present in
    the loaded reference manifests (its owning stream is in scope). Both halves matter: art/texture/audio
    types are unmodeled today AND their streams aren't loaded, so their refs are *unverifiable* → WARNING,
    never a false abort. Computing the intersection (not just "modeled") keeps the self-heal honest — when
    an art type is modeled, its refs only promote to errors once its stream is ALSO added to the reference
    scope; model-only would otherwise re-create the false positive (finding 0015)."""
    verifiable = set(our_type_hashes(cfg)) & _loaded_reference_types(cfg)
    issues: list[tuple] = []
    for src in sources:
        if not src.exists():
            issues.append(("error", str(src), 0, "source file not found"))
            continue
        r = _run(_compile_cmd(cfg, src, work / src.stem), capture_output=True, text=True)
        text = (r.stdout or "") + (r.stderr or "")
        for m in re.finditer(r"Unknown asset '([^']*)' referenced from '([^']*)'", text):
            ref, frm = m.group(1), m.group(2)
            frm_inst = frm.split(":", 1)[-1]
            ref_type = ref.split(":", 1)[0]
            sev = _ref_severity(ref_type, verifiable)
            note = "" if sev == "error" else " (unverifiable — type's stream is outside mod check's reference scope)"
            issues.append((sev, str(src), _find_id_line(src, frm_inst),
                           f"dangling reference: '{frm}' points at unknown asset '{ref}'" + note))
        for m in re.finditer(r"(?:Critical|Error): (.+)", text):
            msg = m.group(1).strip()
            if any(b in msg for b in _BENIGN_DIAG):
                continue
            line = 0
            idm = re.search(r"[A-Za-z]+:([A-Za-z0-9_]+)", msg)   # a Type:Instance named in the message
            if idm:
                line = _find_id_line(src, idm.group(1))
            issues.append(("error", str(src), line, msg))
    return issues


def _check_schema_drift(cfg: dict, declared: list[dict], target: str | None,
                        stream: str | None) -> list[tuple]:
    """Advisory drift check per declared type against the target stream (reuses `_type_drift`)."""
    out: list[tuple] = []
    if not target:
        return out
    seen: set = set()
    for b in declared:
        tag = b["tag"]
        if tag in seen:
            continue
        seen.add(tag)
        d = _type_drift(cfg, tag, target, stream or "static_mod")
        if d and d[0] in ("drift", "mixed"):
            status, our_h, sh = d
            shs = "/".join(f"0x{h:08x}" for h in sh)
            out.append(("warn", b["src"], _find_id_line(Path(b["src"]), b["id"]),
                        f"{tag} is schema-{status} in {target} (stream {shs} vs our "
                        f"0x{our_h:08x})" if our_h is not None else
                        f"{tag} is schema-{status} in {target} (stream {shs})"))
    return out


def run_mod_check(cfg: dict, proj: Path, *, quiet: bool = False) -> int:
    """Shared pre-flight: validate a project's sources + schema drift. Returns the error count
    (warnings don't count). Used by `mod check` and automatically before `mod bake`."""
    import tempfile, shutil
    spec = _read_mod_spec(proj)
    sources = [proj / s for s in spec.get("sources", [])]
    if not sources:
        sys.exit("error: mod.toml needs sources")
    declared: list[dict] = []
    for src in sources:
        if src.exists():
            declared += _declared_blocks(src)
    work = Path(tempfile.mkdtemp(prefix="openwrath-check-"))
    try:
        issues = _check_sources(cfg, sources, work)
        issues += _check_schema_drift(cfg, declared, spec.get("target"), spec.get("stream"))
    finally:
        shutil.rmtree(work, ignore_errors=True)
    errs = sum(1 for sev, *_ in issues if sev == "error")
    if not issues:
        if not quiet:
            print(f"  ✓ mod check: {len(declared)} asset(s), no problems found.")
        return 0
    issues.sort(key=lambda t: (t[0] != "error", t[1], t[2]))
    for sev, f, line, msg in issues:
        loc = f"{f}:{line}" if line else f
        mark = "error" if sev == "error" else "warn "
        print(f"  [{mark}] {loc}: {msg}")
    print(f"\n  {errs} error(s), {len(issues) - errs} warning(s).")
    return errs


def cmd_mod_check(args) -> int:
    cfg = read_config()
    _need(cfg, "openwrath", "sdk", "base_manifests", "schema")
    proj = Path(args.project).resolve()
    print(f"checking '{proj.name}'\n")
    return 1 if run_mod_check(cfg, proj) else 0


def cmd_mod_revert(args) -> int:
    import shutil
    cfg = read_config()
    (mods,) = _need(cfg, "mods_dir")
    if game_running() and not args.force:
        sys.exit("error: Kane's Wrath appears to be RUNNING — close it before reverting (or --force).")
    big = Path(mods) / args.target / "ada_1_Streams.big"
    backup = big.with_suffix(".big.openwrath-backup")
    if not backup.exists():
        sys.exit(f"error: no openwrath backup for {args.target} ({backup.name} missing).")
    if not big_is_complete(backup):
        sys.exit(f"error: the backup {backup.name} is itself truncated/corrupt — NOT restoring "
                 "(that would make things worse). The target mod likely needs a reinstall.")
    shutil.copy2(backup, big)
    with open(big, "rb") as fh:
        os.fsync(fh.fileno())
    if not big_is_complete(big):
        sys.exit("error: restore produced an incomplete big — disk problem? Re-run after freeing space.")
    print(f"reverted {args.target} to the pre-bake backup (verified intact).")
    return 0


# --- discovery: inspect / find / uses / trace --------------------------------------------
# These read the INSTALLED stream (what the game actually loads), so modders can explore the
# data graph instead of needing tribal knowledge of where everything lives. All are driven by
# a shared manifest index built from the target mod's big.

def _resolve_target_big(cfg: dict, target: str | None) -> tuple[Path, str]:
    """Return (ada_1_Streams.big path, target name). If target is None, auto-detect the sole
    installed mod; error (listing candidates) if there are zero or many."""
    (mods,) = _need(cfg, "mods_dir")
    mods = Path(mods)
    if target:
        big = mods / target / "ada_1_Streams.big"
        if not big.exists():
            sys.exit(f"error: no ada_1_Streams.big for target '{target}' at {big}")
        return big, target
    cands = [d for d in sorted(mods.iterdir()) if d.is_dir() and (d / "ada_1_Streams.big").exists()]
    if len(cands) == 1:
        return cands[0] / "ada_1_Streams.big", cands[0].name
    if not cands:
        sys.exit(f"error: no installed mod with an ada_1_Streams.big under {mods}")
    sys.exit("error: multiple installed mods — pass --target <name>: "
             + ", ".join(d.name for d in cands))


def our_type_hashes(cfg: dict) -> dict:
    """Parse the compiler's native type registry (XmlCompiler/Plugin.cs) into {TypeName: TypeHash}.

    This is the schema fingerprint OUR compiler stamps for each type — the retail Kane's Wrath hash. A mod
    stream built against a different schema version will carry a DIFFERENT hash for the same type (schema
    drift); comparing against this map is how `openwrath schema` flags those. Returns {} if Plugin.cs is
    missing. Handles both the plain `(typeof(X), 0xHASHu, ...)` entries and the
    `#if TIBERIUMWARS / #elif KANESWRATH / #endif` conditional ones (we keep the KANESWRATH branch — KW is
    the build target), and namespaced names (`SageBinaryData.Environment` -> `Environment`)."""
    import re
    (ow,) = _need(cfg, "openwrath")
    plugin = Path(ow) / "source/BinaryAssetBuilder.XmlCompiler/BinaryAssetBuilder/XmlCompiler/Plugin.cs"
    if not plugin.exists():
        vlog(f"Plugin.cs not found at {plugin} — drift column unavailable")
        return {}
    txt = plugin.read_text()
    # Drop the TIBERIUMWARS branch of each conditional so only the KANESWRATH hash remains before the entry.
    txt = re.sub(r"#if\s+TIBERIUMWARS.*?#elif\s+KANESWRATH", "", txt, flags=re.S).replace("#endif", "")
    out = {}
    for m in re.finditer(r"typeof\(([\w.]+)\)\s*,\s*0x([0-9A-Fa-f]+)u", txt):
        out[m.group(1).split(".")[-1]] = int(m.group(2), 16)
    vlog(f"parsed {len(out)} native type hashes from Plugin.cs")
    return out


def _extract(big: Path, needle: str, outdir: Path) -> None:
    import subprocess
    subprocess.run(["python3", str(LIB / "bigextract.py"), str(big), needle, str(outdir)],
                   capture_output=True)


def load_stream_index(cfg: dict, target: str | None, stream: str) -> dict:
    """Extract the stream's manifest (only — fast) and build an index of every asset:
    full name ('Type:Instance'), split type/inst, and outgoing (tid,iid) references.
    Returns {entries, by_iid, by_name, big, target, stream}."""
    import struct, tempfile, shutil, time
    big, target = _resolve_target_big(cfg, target)
    vlog(f"target: {target}  big: {big}  stream: {stream}")
    td = Path(tempfile.mkdtemp(prefix="openwrath-idx-"))
    t0 = time.time()
    try:
        _extract(big, f"{stream}.manifest", td)
        mp = td / f"{stream}.manifest"
        if not mp.exists() or mp.stat().st_size == 0:
            sys.exit(f"error: stream '{stream}' not found in {big.name} (extract empty). "
                     f"Streams live as data\\<stream>.manifest inside the big.")
        b = mp.read_bytes()
        h = struct.unpack_from("<11I", b, 4)
        n, arsz, rmsz = h[2], h[7], h[8]
        refbuf_start = MANIFEST_V5_HDR + n * MANIFEST_ENTRY       # AssetRefBuf begins after the entry table
        name_base = refbuf_start + arsz + rmsz                    # AssetNameBuf begins after ref + refManName bufs
        entries, by_iid, by_name = [], {}, {}
        for i in range(n):
            o = MANIFEST_V5_HDR + i * MANIFEST_ENTRY
            tid, iid, th, ih = struct.unpack_from("<4I", b, o)
            aro, arc = struct.unpack_from("<2i", b, o + 16)       # AssetReferenceOffset (bytes), Count
            noff = struct.unpack_from("<i", b, o + 24)[0]
            name = None
            if noff >= 0:
                p = name_base + noff
                name = b[p:b.index(b"\x00", p)].decode("latin1", "replace")
            if name and ":" in name:
                typ, inst = name.split(":", 1)
            else:
                typ, inst = None, name
            refs = []
            base = refbuf_start + aro
            for j in range(arc):
                rt, ri = struct.unpack_from("<2I", b, base + j * 8)  # each ref = (TypeId, InstanceId)
                refs.append((rt, ri))
            e = {"tid": tid, "iid": iid, "th": th, "ih": ih,
                 "name": name, "type": typ, "inst": inst, "refs": refs}
            entries.append(e)
            by_iid[iid] = e
            if inst:
                by_name.setdefault(inst.lower(), []).append(e)
        vlog(f"indexed {len(entries)} assets from {stream}.manifest  ({time.time()-t0:.2f}s)")
        return {"entries": entries, "by_iid": by_iid, "by_name": by_name,
                "big": big, "target": target, "stream": stream}
    finally:
        shutil.rmtree(td, ignore_errors=True)


def _resolve_asset(idx: dict, asset: str, want_type: str | None = None) -> list[dict]:
    """Resolve an instance name to its entries. Prefers an EXACT-case match (so 'NODAvatar' picks
    GameObject:NODAvatar, not a case-variant like OnDemandTextureImage:NodAvatar); falls back to the
    case-insensitive set only when there is no exact-case hit. When want_type is given, restricts
    to assets of that type (so `--type GameObject` disambiguates a name shared across types)."""
    hits = idx["by_name"].get(asset.lower())
    if not hits:
        sys.exit(f"error: '{asset}' not found in stream '{idx['stream']}' of {idx['target']}. "
                 f"Try: openwrath find {asset}")
    if want_type:
        wt = want_type.lower()
        typed = [e for e in hits if e["type"] and e["type"].lower() == wt]
        if not typed:
            avail = sorted({e["type"] for e in hits if e["type"]})
            sys.exit(f"error: no asset named '{asset}' of type '{want_type}'. "
                     f"Available type(s): {', '.join(avail) or '(untyped)'}")
        hits = typed
    exact = [e for e in hits if e["inst"] == asset]
    return exact if exact else hits


def cmd_find(args) -> int:
    idx = load_stream_index(read_config(), args.target, args.stream)
    text = args.text.lower()
    want_type = (args.type or "").lower()
    names = sorted({
        e["name"] for e in idx["entries"]
        if e["inst"] and text in e["inst"].lower()
        and (not want_type or (e["type"] and e["type"].lower() == want_type))
    })
    for nm in names:
        print(nm)
    return 0


def cmd_uses(args) -> int:
    idx = load_stream_index(read_config(), args.target, args.stream)
    targets = {(e["tid"], e["iid"]) for e in _resolve_asset(idx, args.asset, args.type)}
    users = sorted({
        e["name"] for e in idx["entries"]
        if any((rt, ri) in targets for (rt, ri) in e["refs"]) and e["name"]
    })
    for nm in users:
        print(nm)
    return 0


def cmd_trace(args) -> int:
    idx = load_stream_index(read_config(), args.target, args.stream)
    start = _resolve_asset(idx, args.asset, args.type)[0]
    seen: set = set()

    def label(e):
        return e["name"] or f'0x{e["tid"]:08x}:0x{e["iid"]:08x}'

    def walk(e, depth):
        key = (e["tid"], e["iid"])
        if key in seen:
            print("  " * depth + label(e) + "  (seen)")
            return
        print("  " * depth + label(e))
        seen.add(key)
        if depth >= args.depth:
            return
        for (rt, ri) in e["refs"]:
            child = idx["by_iid"].get(ri)
            if child is not None and child["tid"] == rt:
                walk(child, depth + 1)
            else:
                print("  " * (depth + 1) + f"0x{rt:08x}:0x{ri:08x}  (external)")

    walk(start, 0)
    return 0


def _default_stringhashes(cfg: dict) -> str | None:
