def _ask(prompt: str, default: str = "") -> str:
    try:
        ans = input(f"{prompt} " + (f"[{default}] " if default else ""))
    except EOFError:
        return default
    return ans if ans.strip() else default


def _confirm(prompt: str, default: bool = True) -> bool:
    try:
        ans = input(f"{prompt} [{'Y/n' if default else 'y/N'}] ").strip().lower()
    except EOFError:
        return default
    return default if not ans else ans.startswith("y")


def _head(p: Path, n: int = 4096) -> str:
    try:
        return p.read_text(encoding="utf-8", errors="replace")[:n]
    except OSError:
        return ""


def _validate_byo(key: str, path: str) -> str | None:
    """Return a NORMALISED path if `path` really is the thing `key` wants, else None."""
    if not path:
        return None
    p = Path(path).expanduser()
    if key == "sdk":
        if (p / "KanesWrathXMLFiles").is_dir():
            p = p / "KanesWrathXMLFiles"
        if p.is_dir() and (p.name == "KanesWrathXMLFiles" or next(p.rglob("*.xml"), None)):
            return str(p)
        return None
    if key == "schema":
        if p.is_file() and ("cnc3types" in p.name.lower() or "CnC3Types" in _head(p)):
            return str(p)
        return None
    if key == "base_manifests":
        if p.is_dir() and next(p.glob("*.manifest"), None):
            return str(p)
        return None
    if key == "stringhashes":
        if p.is_file() and (p.name.lower() == "stringhashes.xml"
                            or "StringHashTable" in _head(p) or "StringAndHash" in _head(p)):
            return str(p)
        return None
    return None


def _walk_find(roots, matcher, max_depth: int = 6, max_hits: int = 8) -> list[Path]:
    """Bounded search: walk each root to max_depth, pruning hidden/noisy dirs; `matcher(dir,
    subdirs, files)` returns a list of hit Paths at that level. Stops at max_hits."""
    skip = {"node_modules", "__pycache__", "proc", "sys", "dev"}
    hits: list[Path] = []
    for root in roots:
        root = Path(root)
        if not root.exists():
            continue
        base = len(root.parts)
        for dirpath, dirnames, filenames in os.walk(root):
            d = Path(dirpath)
            if len(d.parts) - base >= max_depth:
                dirnames[:] = []
            dirnames[:] = [x for x in dirnames if x not in skip and not x.startswith(".")]
            for h in matcher(d, dirnames, filenames) or []:
                if h not in hits:
                    hits.append(h)
                    if len(hits) >= max_hits:
                        return hits
    return hits


def _byo_candidates(key: str, roots) -> list[Path]:
    import fnmatch
    if key == "sdk":
        def m(d, dn, fn):
            return [d / "KanesWrathXMLFiles"] if "KanesWrathXMLFiles" in dn else []
    elif key == "schema":
        def m(d, dn, fn):
            return [d / f for f in fn if f.lower() == "cnc3types.xsd"]
    elif key == "base_manifests":
        def m(d, dn, fn):
            if any(fnmatch.fnmatch(f, "*_2.manifest") for f in fn):
                return [d]
            return [d] if any(f.lower().endswith(".manifest") for f in fn) else []
    elif key == "stringhashes":
        def m(d, dn, fn):
            return [d / f for f in fn if f.lower() == "stringhashes.xml"]
    else:
        return []
    return _walk_find(roots, m)


def _offer_generator(key: str, cfg: dict, auto: bool) -> str:
    """If a missing byo item can be PRODUCED, offer to run its generator now. Never runs
    unprompted in non-interactive mode (the generators are heavy and need real data)."""
    if auto:
        return ""
    if key == "stringhashes" and cfg.get("sdk") and cfg.get("schema"):
        if _confirm("    generate StringHashes.xml now (compiles your SDK — can take a while)?", True):
            write_config(cfg)
            try:
                cmd_gen_stringhashes(argparse.Namespace(out=None, source=None))
            except SystemExit as e:
                print(f"    gen-stringhashes skipped: {e}")
            return read_config().get("stringhashes", "")
    if key == "base_manifests" and cfg.get("game_install"):
        if _confirm("    extract base manifests from the installed game now?", True):
            write_config(cfg)
            try:
                cmd_extract_manifests(argparse.Namespace(out=None))
            except SystemExit as e:
                print(f"    extract-manifests skipped: {e}")
            return read_config().get("base_manifests", "")
    return ""


def _init_byo(key: str, cfg: dict, roots, auto: bool) -> str:
    desc = dict((s[0], s[2]) for s in SCHEMA)[key]
    cur = cfg.get(key, "")
    valid_cur = _validate_byo(key, cur)
    if valid_cur and (auto or _confirm(f"  {key}: keep configured {valid_cur}?", True)):
        print(f"  [ok ] {key:15} {valid_cur}")
        return valid_cur

    for c in _byo_candidates(key, roots):
        v = _validate_byo(key, str(c))
        if not v:
            continue
        if auto or _confirm(f"  {key}: use {v}?", True):
            print(f"  [ok ] {key:15} {v}")
            return v

    if not auto:
        while True:
            ans = _ask(f"  {key} ({desc}) — enter a path, or blank to skip:", "")
            if not ans.strip():
                break
            v = _validate_byo(key, ans.strip())
            if v:
                print(f"  [ok ] {key:15} {v}")
                return v
            print(f"    that is not a valid {key} — try again (blank to skip).")

    gen = _offer_generator(key, cfg, auto)
    if gen:
        print(f"  [ok ] {key:15} {gen}")
        return gen
    print(f"  [-- ] {key:15} (unset) — {_BYO_HINTS.get(key, '')}")
    return ""


def cmd_init(args) -> int:
    auto = bool(getattr(args, "non_interactive", False) or getattr(args, "yes", False)
                or not sys.stdin.isatty())
    print("openwrath init — guided setup\n")
    if auto:
        print("  (non-interactive: accepting detected / validated defaults)\n")

    cfg = read_config()                      # idempotent: keep whatever is already good
    root, install, prefix = find_install_and_prefix()
    repo = openwrath_dir()
    found = dict(cfg)
    if root:    found["steam_root"] = str(root)
    if install: found["game_install"] = str(install)
    if prefix:  found["prefix"] = str(prefix)
    if prefix and (mods := find_mods_dir(prefix)):
        found["mods_dir"] = str(mods)
    elif is_wsl() and (mods := find_mods_dir_wsl()):
        found["mods_dir"] = str(mods)
    if install and (sku := find_install_skudef(install)):
        found["install_skudef"] = str(sku)
    found["openwrath"] = str(repo)
    for k, v in probe_byo(repo).items():
        found.setdefault(k, v)
    write_config(found)                      # persist so generators can read sdk/schema/install

    print("auto-detected:")
    for key, kind, _desc in SCHEMA:
        if kind != "auto":
            continue
        val = found.get(key, "")
        print(f"  [{'ok ' if val else '!! '}] {key:15} {val or '(not found)'}")

    search_roots = [Path.home()]
    if install:
        search_roots.append(install)
    if prefix:
        search_roots.append(prefix)
    if is_wsl():
        for drive in windows_drives():
            search_roots += [drive / "Users", drive / "Program Files",
                             drive / "Program Files (x86)"]

    print("\nbring-your-own:")
    for key in ("sdk", "base_manifests", "schema", "stringhashes"):
        found[key] = _init_byo(key, found, search_roots, auto)
        write_config(found)                  # incremental, so a later generator sees earlier keys

    print(f"\nconfig written -> {CONFIG_PATH}\n")
    cmd_show(argparse.Namespace())
    ready = all(found.get(k) for k, _, _ in SCHEMA)
    print("\nnext:")
    if ready:
        print("  modkit/openwrath find <text>      # explore installed assets")
        print("  modkit/openwrath mod bake <dir>   # build a mod")
    else:
        print("  fill the remaining paths above (see SETUP.md), then re-run `openwrath init`")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="openwrath", description=__doc__.splitlines()[0])
    # Global -v/--verbose, accepted either before OR after the subcommand. The shared copy uses
    # SUPPRESS so that, when absent at the sub level, it does not clobber a value given before it.
    ap.add_argument("-v", "--verbose", action="store_true", default=False,
                    help="print diagnostics (resolved paths, cache hit/miss, timings) to stderr")
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-v", "--verbose", action="store_true", default=argparse.SUPPRESS,
                        help="print diagnostics to stderr")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("detect", parents=[common],
                   help="auto-discover KW install/prefix/mods/SDK + write config")
    sub.add_parser("show", parents=[common],
                   help="print the resolved config and flag missing paths")
    ini = sub.add_parser("init", parents=[common],
                         help="guided setup: detect + confirm bring-your-own paths + write config")
    ini.add_argument("--non-interactive", dest="non_interactive", action="store_true",
                     help="accept detected/validated defaults without prompting (CI-safe)")
    ini.add_argument("-y", "--yes", dest="yes", action="store_true",
                     help="assume yes — accept all defaults without prompting")
    ini.set_defaults(func=cmd_init)
    gsh = sub.add_parser("gen-stringhashes", parents=[common],
                         help="generate the master StringHashes.xml from your SDK (needs sdk + schema)")
    gsh.add_argument("--out", help="output path (default: $XDG_DATA_HOME/openwrath/StringHashes.xml)")
    gsh.add_argument("--source", help="SDK source file or dir to compile (default: your sdk)")
    gsh.set_defaults(func=cmd_gen_stringhashes)
    em = sub.add_parser("extract-manifests", parents=[common],
                        help="extract + decompress the base-stream manifests from the installed game")
    em.add_argument("--out", help="output dir (default: $XDG_DATA_HOME/openwrath/base-manifests)")
    em.set_defaults(func=cmd_extract_manifests)
    mod = sub.add_parser("mod", parents=[common],
                         help="build/manage mods").add_subparsers(dest="mcmd", required=True)
    b = mod.add_parser("bake", parents=[common],
                       help="compile a mod's overrides + splice them into its target stream")
    b.add_argument("project", help="path to the mod project dir (contains mod.toml)")
    b.add_argument("--force", action="store_true", help="bake even if the game appears to be running")
    b.add_argument("--no-check", dest="no_check", action="store_true",
                   help="skip the automatic pre-flight validation (dangling refs / unknown fields)")
    b.add_argument("--adopt-schema", dest="adopt_schema", action="store_true",
                   help="INSERT a new asset of a drifted type by stamping the target stream's schema hash "
                        "for that type (instead of our compiler's). Needed to add assets of types the target "
                        "mod diverged on; verify in-game after. Without this, drift aborts the bake.")
    b.set_defaults(func=cmd_mod_bake)
    r = mod.add_parser("revert", parents=[common],
                       help="restore a target mod's big from the last openwrath backup")
    r.add_argument("target", help="target mod name (e.g. SecondIsomer)")
    r.add_argument("--force", action="store_true", help="revert even if the game appears to be running")
    r.set_defaults(func=cmd_mod_revert)
    n = mod.add_parser("new", parents=[common], help="scaffold a new mod project (mod.toml + src/)")
    n.add_argument("project", help="path to create for the mod project")
    n.add_argument("--target", help="installed mod to bake into (e.g. SecondIsomer); can be set later in mod.toml")
    n.add_argument("--stream", default="static_mod", help="target stream (default: static_mod)")
    n.add_argument("--name", help="mod name (default: the project dir name)")
    n.set_defaults(func=cmd_mod_new)
    ad = mod.add_parser("add", parents=[common],
                        help="pull an asset into a project as an editable override (from the SDK source)")
    ad.add_argument("project", help="path to the mod project dir (contains mod.toml)")
    ad.add_argument("asset", help="instance name, e.g. GDIMammothTank")
    ad.add_argument("--type", help="restrict to an asset type (disambiguates a shared name)")
    ad.add_argument("--force", action="store_true", help="overwrite an existing override file")
    ad.set_defaults(func=cmd_mod_add)
    pk = mod.add_parser("package", parents=[common],
                        help="produce a self-contained, shareable mod (own big + SkuDef) for Mods/")
    pk.add_argument("project", help="path to the mod project dir (contains mod.toml)")
    pk.add_argument("--stream", help="overlay stream name (default: mod.toml stream, else static_mod)")
    pk.add_argument("--out", help="output dir for the package (default: <project>/dist/<name>)")
    pk.add_argument("--install", action="store_true",
                    help="also copy the package into your Mods/ dir (still needs the master-SkuDef "
                         "add-config line printed at the end to activate)")
    pk.add_argument("--force", action="store_true", help="install even if the game appears to be running")
    pk.set_defaults(func=cmd_mod_package)
    bl = mod.add_parser("build-local", parents=[common],
                        help="assemble a COMPLETE, loadable static mod from your running patch overlay "
                             "+ your edits (EA-derived → LOCAL-ONLY, not shareable)")
    bl.add_argument("project", help="path to the mod project dir (contains mod.toml)")
    bl.add_argument("--stream", help="overlay stream (default: mod.toml stream, else static_mod)")
    bl.add_argument("--out", help="output dir (default: <project>/dist-local/<name>)")
    bl.add_argument("--install", action="store_true",
                    help="also copy the mod into your Mods/ dir (still needs the master-SkuDef "
                         "add-config line printed at the end to activate)")
    bl.add_argument("--no-check", dest="no_check", action="store_true",
                    help="skip the automatic pre-flight validation")
    bl.add_argument("--adopt-schema", dest="adopt_schema", action="store_true",
                    help="INSERT a new asset of a drifted type by adopting the overlay's schema hash "
                         "(verify in-game). Without this, drift aborts the build.")
    bl.add_argument("--force", action="store_true", help="install even if the game appears to be running")
    bl.set_defaults(func=cmd_mod_build_local)
    ck = mod.add_parser("check", parents=[common],
                        help="pre-flight validation (dangling refs / unknown fields / schema drift)")
    ck.add_argument("project", help="path to the mod project dir (contains mod.toml)")
    ck.set_defaults(func=cmd_mod_check)

    # discovery commands (read the installed stream; help you find what to mod + what it touches)
    def _disc(name, help):
        p = sub.add_parser(name, parents=[common], help=help)
        p.add_argument("--target", help="installed mod to read (default: the sole installed mod)")
        p.add_argument("--stream", default="static_mod", help="linked stream to read (default: static_mod)")
        p.add_argument("--type", help="restrict to an asset type, e.g. GameObject (disambiguates a shared name)")
        return p
    ins = _disc("inspect", "decompile + print ONE asset from the installed stream")
    ins.add_argument("asset", help="instance name, e.g. GDIMARV")
    ins.add_argument("--source", action="store_true",
                     help="print the authoring XML from the SDK source tree instead of decompiling")
    ins.add_argument("--no-cache", dest="no_cache", action="store_true",
                     help="bypass the extracted-stream cache (always re-extract)")
    ins.set_defaults(func=cmd_inspect)
    fnd = _disc("find", "list assets whose name contains TEXT")
    fnd.add_argument("text", help="substring to match in the instance name")
    fnd.set_defaults(func=cmd_find)
    use = _disc("uses", "list assets that REFERENCE an asset (reverse refs)")
    use.add_argument("asset", help="instance name, e.g. NODVenomLocomotor")
    use.set_defaults(func=cmd_uses)
    tr = _disc("trace", "print the outgoing reference tree of an asset")
    tr.add_argument("asset", help="instance name, e.g. NODAvatar")
    tr.add_argument("--depth", type=int, default=3, help="how deep to walk (default 3)")
    tr.set_defaults(func=cmd_trace)
    sc = _disc("schema", "show a stream's per-type schema hashes + where they DRIFT from our compiler")
    sc.add_argument("--drift-only", dest="drift_only", action="store_true",
                    help="show only types whose hash differs from our compiler (the insert-unsafe ones)")
    sc.set_defaults(func=cmd_schema)

    ver = sub.add_parser("verify", parents=[common],
                         help="byte-exact check of an asset against the GAME'S OWN shipped bytes")
    ver.add_argument("asset", help="instance name, e.g. GDIConstructionYard")
    ver.add_argument("--type", help="restrict the reported result to this asset type")
    ver.add_argument("--stream", help="base stream to check (default: static_common)")
    ver.add_argument("--no-cache", dest="no_cache", action="store_true",
                     help="bypass the extracted-stream cache (always re-extract)")
    ver.set_defaults(func=cmd_verify)

    args = ap.parse_args()
    global _VERBOSE
    _VERBOSE = getattr(args, "verbose", False)
    if args.cmd == "detect":
        return cmd_detect(args)
    if args.cmd == "show":
        return cmd_show(args)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
